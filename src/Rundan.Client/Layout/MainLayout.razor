@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject RundanApi Api
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header">
        @if (ShowMenu)
        {
            <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu"
                    aria-expanded="@_menuOpen" aria-controls="app-menu-sheet">
                <span></span><span></span><span></span>
            </button>
        }
        @* "/" is just the cold-start launcher (it auto-redirects), so the logo points at the
           events overview — a real destination instead of a screen that forwards straight back. *@
        <a href="events" class="brand">
            <img src="img/rundan-mark.svg" alt="" />
            <span class="wordmark">@AppName</span>
        </a>
        <span class="spacer"></span>
        @* "Host settings" lives in the menu now; the only thing kept here is the preview-exit
           affordance, since leaving "preview as player" has no equivalent in the menu. *@
        @if (State.PreviewAsPlayer)
        {
            <button class="badge admin" style="border:none;cursor:pointer" @onclick="ExitPreviewAsync">Player preview · Exit</button>
        }
    </header>

    @if (State.IsProxying)
    {
        <div class="proxy-bar" role="status">
            <span>Playing for <b>@State.Proxy!.Name</b> — answers and scores count for them.</span>
            <button class="proxy-bar__stop" @onclick="StopProxyAsync">Stop</button>
        </div>
    }

    <main class="app-main">
        @if (!_ready)
        {
            <div class="card center muted">
                <div class="spinner" style="margin:1rem auto"></div>
                Loading…
            </div>
        }
        else if (_unreachable)
        {
            <div class="card stack center">
                <h1>Can't reach the server</h1>
                <p class="muted">Check your connection and try again.</p>
                <button class="btn" @onclick="RetryAsync">Retry</button>
            </div>
        }
        else if (_needAccess)
        {
            <AccessGate OnUnlocked="OnUnlocked" />
        }
        else
        {
            @Body
        }
    </main>

    @* Rendered at the shell root (outside the header's stacking context) so the overlay layers correctly. *@
    @if (ShowMenu)
    {
        <AppMenu Open="_menuOpen" OnClose="CloseMenu" />
    }
</div>

@code {
    private bool _ready;
    private bool _needAccess;
    private bool _unreachable;
    private bool _menuOpen;

    private string AppName => State.Bootstrap?.AppName ?? "Rundan";

    // The header menu (and its "jump in with a code" box) only makes sense once we're past the
    // loading / unreachable / access-gate states — navigating from it would otherwise dead-end.
    private bool ShowMenu => _ready && !_unreachable && !_needAccess;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu()
    {
        _menuOpen = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await InitAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;

    // Stop covering a player. Force a reload so the current page re-reads the (now own) session.
    private async Task StopProxyAsync()
    {
        await State.ClearProxyAsync();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task InitAsync()
    {
        _ready = false;
        _unreachable = false;
        _needAccess = false;

        await State.EnsureInitializedAsync(Api);

        if (State.Bootstrap is null)
        {
            _unreachable = true;
            _ready = true;
            return;
        }

        try
        {
            if (State.Bootstrap.RequiresAccessCode)
            {
                _needAccess = string.IsNullOrEmpty(State.AccessCode)
                              || !await Api.VerifyAccessCodeAsync(State.AccessCode!);
            }
        }
        catch
        {
            // Re-verifying the stored code hit a transport error (flaky signal). Surface the
            // retry screen instead of hanging on the loading spinner forever.
            _unreachable = true;
        }

        _ready = true;
    }

    private async Task RetryAsync() => await InitAsync();

    private void OnUnlocked()
    {
        _needAccess = false;
        StateHasChanged();
    }

    private async Task ExitPreviewAsync()
    {
        await State.SetPreviewAsync(false);
        StateHasChanged();
    }
}
