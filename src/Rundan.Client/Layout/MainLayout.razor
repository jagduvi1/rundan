@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject RundanApi Api
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-header">
        <a href="" class="brand">
            <img src="img/rundan-mark.svg" alt="" />
            <span class="wordmark">@AppName</span>
        </a>
        <span class="spacer"></span>
        @if (State.PreviewAsPlayer)
        {
            <button class="badge admin" style="border:none;cursor:pointer" @onclick="ExitPreviewAsync">Player preview · Exit</button>
        }
        else
        {
            <a href="admin" class="badge admin">Host</a>
        }
    </header>

    @if (State.IsProxying)
    {
        <div class="proxy-bar" role="status">
            <span>Playing for <b>@State.Proxy!.Name</b> — answers and scores count for them.</span>
            <button class="proxy-bar__stop" @onclick="StopProxyAsync">Stop</button>
        </div>
    }

    <main class="app-main">
        @if (!_ready)
        {
            <div class="card center muted">
                <div class="spinner" style="margin:1rem auto"></div>
                Loading…
            </div>
        }
        else if (_unreachable)
        {
            <div class="card stack center">
                <h1>Can't reach the server</h1>
                <p class="muted">Check your connection and try again.</p>
                <button class="btn" @onclick="RetryAsync">Retry</button>
            </div>
        }
        else if (_needAccess)
        {
            <AccessGate OnUnlocked="OnUnlocked" />
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    private bool _ready;
    private bool _needAccess;
    private bool _unreachable;

    private string AppName => State.Bootstrap?.AppName ?? "Rundan";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await InitAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;

    // Stop covering a player. Force a reload so the current page re-reads the (now own) session.
    private async Task StopProxyAsync()
    {
        await State.ClearProxyAsync();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task InitAsync()
    {
        _ready = false;
        _unreachable = false;
        _needAccess = false;

        await State.EnsureInitializedAsync(Api);

        if (State.Bootstrap is null)
        {
            _unreachable = true;
            _ready = true;
            return;
        }

        if (State.Bootstrap.RequiresAccessCode)
        {
            _needAccess = string.IsNullOrEmpty(State.AccessCode)
                          || !await Api.VerifyAccessCodeAsync(State.AccessCode!);
        }

        _ready = true;
    }

    private async Task RetryAsync() => await InitAsync();

    private void OnUnlocked()
    {
        _needAccess = false;
        StateHasChanged();
    }

    private async Task ExitPreviewAsync()
    {
        await State.SetPreviewAsync(false);
        StateHasChanged();
    }
}
