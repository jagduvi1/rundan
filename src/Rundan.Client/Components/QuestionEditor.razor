@inject RundanApi Api

<div class="card">
    <h2>Questions (@_questions.Count)</h2>
    @if (_questions.Count == 0)
    {
        <p class="muted">No questions yet — add the first one below@(Activity.UsesMap ? ", or set a station count above." : ".")</p>
    }
    else
    {
        <ul class="list">
            @foreach (var q in _questions)
            {
                <li style="flex-wrap:wrap">
                    <span class="grow">
                        <b>@q.Order.</b>
                        @if (string.IsNullOrWhiteSpace(q.Text))
                        {
                            <span class="muted"><i>No question yet</i></span>
                        }
                        else
                        {
                            @q.Text
                        }
                        <span class="muted" style="font-size:.78rem">
                            · @KindLabel(q.Kind) · @q.Points pt@(q.Points == 1 ? "" : "s")
                        </span>
                    </span>
                    @if (!q.IsComplete)
                    {
                        <span class="badge" title="Needs text and an answer key">needs question</span>
                    }
                    <button class="btn ghost small" @onclick="() => StartEdit(q)" disabled="@_busy">
                        @(string.IsNullOrWhiteSpace(q.Text) ? "Add question" : "Edit")
                    </button>
                    <button class="btn ghost small danger" @onclick="() => DeleteAsync(q.Id)" disabled="@_busy">✕</button>
                </li>
            }
        </ul>
    }
</div>

<div class="card stack">
    <h2>From the question library</h2>
    <p class="muted" style="font-size:.85rem">Pull random questions you didn't write (great when the host plays too). Pick tags, choose how many — they're marked used so they won't repeat.</p>

    @if (_libError is not null)
    {
        <div class="alert error">@_libError</div>
    }

    @if (TopicTags.Count > 0)
    {
        <div class="field">
            <label>Categories (pick one or more)</label>
            <div class="row wrap" style="gap:.4rem">
                @foreach (var tag in TopicTags)
                {
                    <button class="btn small @(_selectedTags.Contains(tag) ? "" : "ghost")" @onclick="() => ToggleTagAsync(tag)">@Label(tag)</button>
                }
            </div>
        </div>
    }
    @if (AgeTags.Count > 0)
    {
        <div class="field">
            <label>Age (optional)</label>
            <div class="row wrap" style="gap:.4rem">
                @foreach (var tag in AgeTags)
                {
                    <button class="btn small @(_selectedTags.Contains(tag) ? "" : "ghost")" @onclick="() => ToggleTagAsync(tag)">@Label(tag)</button>
                }
            </div>
        </div>
    }
    @if (DifficultyTags.Count > 0)
    {
        <div class="field">
            <label>Difficulty (optional)</label>
            <div class="row wrap" style="gap:.4rem">
                @foreach (var tag in DifficultyTags)
                {
                    <button class="btn small @(_selectedTags.Contains(tag) ? "" : "ghost")" @onclick="() => ToggleTagAsync(tag)">@Label(tag)</button>
                }
            </div>
        </div>
    }

    <div class="row">
        <div class="field" style="width:150px">
            <label>Number of questions</label>
            <input type="number" min="1" max="50" @bind="_libCount" />
        </div>
        <span class="muted grow" style="align-self:flex-end;padding-bottom:.6rem">@_libAvailable available</span>
        <button class="btn success" style="align-self:flex-end" @onclick="GenerateAsync" disabled="@(_libBusy || _libAvailable == 0)">
            Add random
        </button>
    </div>
</div>

<div class="card stack">
    <h2>@(_editId is null ? "Add a question" : $"Edit station #{_editOrder}")</h2>

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }

    <div class="field">
        <label>Question</label>
        <textarea @bind="_text" placeholder="What's the question?"></textarea>
    </div>

    <div class="row">
        <div class="field grow">
            <label>Type</label>
            <select @bind="_kind">
                <option value="@QuestionKind.MultipleChoice">Multiple choice</option>
                <option value="@QuestionKind.TrueFalse">True / false</option>
                <option value="@QuestionKind.FreeText">Free text</option>
            </select>
        </div>
        <div class="field" style="width:90px">
            <label>Points</label>
            <input type="number" min="0" max="100" @bind="_points" />
        </div>
    </div>

    @if (_kind == QuestionKind.MultipleChoice)
    {
        <div class="field">
            <label>Options (tap the circle to mark the correct one)</label>
            @for (var i = 0; i < _options.Count; i++)
            {
                var index = i;
                <div class="row" style="margin-bottom:.4rem">
                    <input type="radio" name="correct" style="width:auto;min-height:auto"
                           checked="@(_correctIndex == index)" @onchange="() => _correctIndex = index" />
                    <input class="grow" placeholder="@($"Option {index + 1}")" value="@_options[index]"
                           @oninput="e => _options[index] = e.Value?.ToString() ?? string.Empty" />
                    @if (_options.Count > 2)
                    {
                        <button class="btn ghost small" @onclick="() => RemoveOption(index)">✕</button>
                    }
                </div>
            }
            <button class="btn ghost small" @onclick="AddOption">+ Add option</button>
        </div>
    }
    else if (_kind == QuestionKind.TrueFalse)
    {
        <div class="field">
            <label>Correct answer</label>
            <select @bind="_trueIsCorrect">
                <option value="true">True</option>
                <option value="false">False</option>
            </select>
        </div>
    }
    else
    {
        <div class="field">
            <label>Accepted answer (case-insensitive)</label>
            <input @bind="_acceptedAnswer" placeholder="The correct text" />
        </div>
    }

    <div class="row">
        <button class="btn block success" @onclick="SaveAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_text))">
            @(_editId is null ? "Add question" : "Save changes")
        </button>
        @if (_editId is not null)
        {
            <button class="btn ghost" @onclick="CancelEdit" disabled="@_busy">Cancel</button>
        }
    </div>
</div>

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;

    /// <summary>Bumped by the parent when the stations panel changes questions, to keep both in sync.</summary>
    [Parameter] public int RefreshKey { get; set; }

    /// <summary>Raised after this editor changes the question set, so the parent can refresh the stations panel.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<QuestionAdminDto> _questions = new();
    private int _lastRefreshKey = -1;

    // Add / edit form. _editId is null when adding, or the question id being edited.
    private int? _editId;
    private int _editOrder;
    private double? _editLat;
    private double? _editLng;
    private int? _editRadius;
    private string _text = string.Empty;
    private QuestionKind _kind = QuestionKind.MultipleChoice;
    private int _points = 1;
    private List<string> _options = new() { string.Empty, string.Empty };
    private int _correctIndex;
    private bool _trueIsCorrect = true;
    private string _acceptedAnswer = string.Empty;

    private bool _busy;
    private string? _error;

    // Question library
    private List<string> _tags = new();
    private readonly HashSet<string> _selectedTags = new();
    private int _libCount = 10;
    private int _libAvailable;
    private bool _libBusy;
    private string? _libError;

    private List<string> TopicTags => _tags.Where(t => t.StartsWith("topic:", StringComparison.Ordinal)).ToList();
    private List<string> AgeTags => _tags.Where(t => t.StartsWith("age:", StringComparison.Ordinal)).ToList();
    private List<string> DifficultyTags => _tags.Where(t => t.StartsWith("difficulty:", StringComparison.Ordinal)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { _tags = await Api.GetLibraryTagsAsync(); } catch (ApiException) { }
        await RefreshAvailableAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastRefreshKey != RefreshKey)
        {
            _lastRefreshKey = RefreshKey;
            await ReloadAsync();
        }
    }

    private async Task ToggleTagAsync(string tag)
    {
        if (!_selectedTags.Add(tag))
        {
            _selectedTags.Remove(tag);
        }

        await RefreshAvailableAsync();
    }

    private async Task RefreshAvailableAsync()
    {
        try { _libAvailable = await Api.GetLibraryAvailableAsync(_selectedTags.ToList()); }
        catch (ApiException) { _libAvailable = 0; }
    }

    private async Task GenerateAsync()
    {
        _libBusy = true;
        _libError = null;
        try
        {
            var result = await Api.GenerateFromLibraryAsync(Activity.Id, _libCount, _selectedTags.ToList());
            _libAvailable = result.Available;
            await ReloadAsync();
            await NotifyChangedAsync();
            if (result.Added == 0)
            {
                _libError = "No matching questions left for those tags.";
            }
        }
        catch (ApiException ex)
        {
            _libError = ex.Message;
        }
        finally
        {
            _libBusy = false;
        }
    }

    // "topic:sport" -> "Sport", "age:family" -> "Family".
    private static string Label(string tag)
    {
        var i = tag.IndexOf(':');
        var s = i >= 0 ? tag[(i + 1)..] : tag;
        return s.Length == 0 ? tag : char.ToUpperInvariant(s[0]) + s[1..];
    }

    private async Task ReloadAsync()
    {
        try
        {
            _questions = await Api.GetAdminQuestionsAsync(Activity.Id);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void AddOption() => _options.Add(string.Empty);

    private void RemoveOption(int index)
    {
        _options.RemoveAt(index);
        if (_correctIndex >= _options.Count)
        {
            _correctIndex = _options.Count - 1;
        }
    }

    // Load an existing question (including a blank station) into the form for editing.
    private void StartEdit(QuestionAdminDto q)
    {
        _editId = q.Id;
        _editOrder = q.Order;
        _editLat = q.Latitude;       // preserve the geofence set in the Stations panel
        _editLng = q.Longitude;
        _editRadius = q.RadiusMeters;
        _text = q.Text;
        _kind = q.Kind;
        _points = q.Points;
        _error = null;

        if (q.Kind == QuestionKind.FreeText)
        {
            _acceptedAnswer = q.AcceptedFreeTextAnswer ?? string.Empty;
            _options = new() { string.Empty, string.Empty };
            _correctIndex = 0;
        }
        else if (q.Kind == QuestionKind.TrueFalse)
        {
            _trueIsCorrect = q.Options.FirstOrDefault(o => o.IsCorrect)?.Text == "True";
            _options = new() { string.Empty, string.Empty };
            _correctIndex = 0;
        }
        else
        {
            _options = q.Options.Count >= 2 ? q.Options.Select(o => o.Text).ToList() : new() { string.Empty, string.Empty };
            var correct = q.Options.FindIndex(o => o.IsCorrect);
            _correctIndex = correct >= 0 ? correct : 0;
        }
    }

    private void CancelEdit() => ResetForm();

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;

        var request = new QuestionUpsertRequest
        {
            Order = _editOrder,
            Text = _text.Trim(),
            Kind = _kind,
            Points = _points,
            // Carry the station's geofence through a content edit (the update replaces these).
            Latitude = _editLat,
            Longitude = _editLng,
            RadiusMeters = _editRadius,
        };

        switch (_kind)
        {
            case QuestionKind.MultipleChoice:
                request.Options = _options
                    .Select((t, i) => new AnswerOptionUpsert { Text = t.Trim(), IsCorrect = i == _correctIndex })
                    .Where(o => o.Text.Length > 0)
                    .ToList();
                break;
            case QuestionKind.TrueFalse:
                request.Options = new()
                {
                    new AnswerOptionUpsert { Text = "True", IsCorrect = _trueIsCorrect },
                    new AnswerOptionUpsert { Text = "False", IsCorrect = !_trueIsCorrect },
                };
                break;
            case QuestionKind.FreeText:
                request.AcceptedFreeTextAnswer = _acceptedAnswer.Trim();
                break;
        }

        try
        {
            if (_editId is { } editId)
            {
                await Api.UpdateQuestionAsync(Activity.Id, editId, request);
            }
            else
            {
                await Api.AddQuestionAsync(Activity.Id, request);
            }

            ResetForm();
            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetForm()
    {
        _editId = null;
        _editOrder = 0;
        _editLat = null;
        _editLng = null;
        _editRadius = null;
        _text = string.Empty;
        _kind = QuestionKind.MultipleChoice;
        _points = 1;
        _options = new() { string.Empty, string.Empty };
        _correctIndex = 0;
        _trueIsCorrect = true;
        _acceptedAnswer = string.Empty;
        _error = null;
    }

    private async Task DeleteAsync(int questionId)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DeleteQuestionAsync(Activity.Id, questionId);
            if (_editId == questionId)
            {
                ResetForm();
            }

            await ReloadAsync();
            await NotifyChangedAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string KindLabel(QuestionKind kind) => kind switch
    {
        QuestionKind.MultipleChoice => "Multiple choice",
        QuestionKind.TrueFalse => "True/false",
        QuestionKind.FreeText => "Free text",
        _ => kind.ToString(),
    };

    private Task NotifyChangedAsync() => OnChanged.HasDelegate ? OnChanged.InvokeAsync() : Task.CompletedTask;
}
