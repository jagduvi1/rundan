@inject RundanApi Api

<div class="card stack">
    <div class="row">
        <h3 class="grow" style="margin:0">Tracks</h3>
        <button class="btn small" @onclick="AddAsync" disabled="@_busy">Add a track</button>
    </div>
    <p class="muted" style="font-size:.82rem;margin:0">
        Paste a Spotify track link (you'll play it), then the correct song and artist. Players type both;
        each correct guess is worth the track's points. Add a <b>release year</b> for a Hitster-style round —
        players then also guess the year (exact = full points, within 2 years = half). Players never see the link or the answers.
    </p>

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }

    @if (_tracks.Count == 0)
    {
        <p class="muted">No tracks yet — add the first one.</p>
    }

    @foreach (var (t, i) in _tracks.Select((t, i) => (t, i)))
    {
        <div class="card stack" style="background:var(--paper-2, #faf7f2)">
            <div class="row">
                <b class="grow">Track @(i + 1)</b>
                @if (!string.IsNullOrWhiteSpace(t.SpotifyUrl))
                {
                    <a class="btn ghost small" href="@t.SpotifyUrl" target="_blank" rel="noopener">▶ Open</a>
                }
                <button class="btn ghost small danger" @onclick="() => DeleteAsync(t)" disabled="@_busy">Remove</button>
            </div>
            <div class="row" style="gap:.4rem">
                <input class="grow" placeholder="Spotify track link (https://open.spotify.com/track/…)" @bind="t.SpotifyUrl" />
                <button class="btn ghost small" @onclick="() => AutoFillAsync(t)"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(t.SpotifyUrl))" title="Look up title/artist/year from the link">
                    @(_fillingId == t.Id ? "…" : "Auto-fill")
                </button>
            </div>
            @if (_fillNote.TryGetValue(t.Id, out var note))
            {
                <p class="muted" style="font-size:.78rem;margin:0">@note</p>
            }
            <div class="row wrap">
                <input class="grow" placeholder="Song title (correct answer)" @bind="t.AcceptedFreeTextAnswer" />
                <input class="grow" placeholder="Artist (correct answer)" @bind="t.AcceptedArtist" />
            </div>
            <div class="row wrap">
                <div class="row" style="gap:.4rem">
                    <label class="muted" style="font-size:.85rem">Points each</label>
                    <input type="number" min="0" max="100" style="width:80px" @bind="t.Points" />
                </div>
                <div class="row" style="gap:.4rem">
                    <label class="muted" style="font-size:.85rem">Release year</label>
                    <input type="number" min="1860" max="2100" placeholder="—" style="width:90px" @bind="t.ReleaseYear" />
                </div>
                <span class="grow"></span>
                <button class="btn small success" @onclick="() => SaveAsync(t)" disabled="@_busy">Save</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;
    [Parameter] public int RefreshKey { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<QuestionAdminDto> _tracks = new();
    private bool _busy;
    private string? _error;
    private int _loadedId = -1;
    private int _fillingId = -1;
    private readonly Dictionary<int, string> _fillNote = new();

    // Auto-fill a track's title/artist/year from its Spotify link (free oEmbed + MusicBrainz lookup).
    // Only fills blank fields so it never clobbers something the host already typed; they confirm + Save.
    private async Task AutoFillAsync(QuestionAdminDto t)
    {
        if (string.IsNullOrWhiteSpace(t.SpotifyUrl))
        {
            return;
        }

        _fillingId = t.Id;
        _fillNote.Remove(t.Id);
        _error = null;
        try
        {
            var found = await Api.LookupTrackAsync(Activity.Id, t.SpotifyUrl);
            var added = new List<string>();
            if (!string.IsNullOrWhiteSpace(found.Title) && string.IsNullOrWhiteSpace(t.AcceptedFreeTextAnswer))
            {
                t.AcceptedFreeTextAnswer = found.Title; added.Add("song");
            }
            if (!string.IsNullOrWhiteSpace(found.Artist) && string.IsNullOrWhiteSpace(t.AcceptedArtist))
            {
                t.AcceptedArtist = found.Artist; added.Add("artist");
            }
            if (found.Year is int y && t.ReleaseYear is null)
            {
                t.ReleaseYear = y; added.Add("year");
            }

            _fillNote[t.Id] = added.Count > 0
                ? $"Filled {string.Join(", ", added)} — check it and press Save."
                : found.Found ? "Found it, but those fields were already set." : "Couldn't find it — type the answers in.";
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _fillingId = -1; }
    }

    // Load once per activity — never re-fetch on a RefreshKey bump, which would clobber unsaved in-place edits.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Activity.Id)
        {
            _loadedId = Activity.Id;
            try { _tracks = await Api.GetAdminQuestionsAsync(Activity.Id); }
            catch (ApiException ex) { _error = ex.Message; }
        }
    }

    private async Task AddAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var order = _tracks.Count == 0 ? 1 : _tracks.Max(t => t.Order) + 1;
            var created = await Api.AddQuestionAsync(Activity.Id, new QuestionUpsertRequest
            {
                Order = order,
                Text = $"Track {order}",
                Kind = QuestionKind.FreeText,
                Points = 1,
            });
            _tracks.Add(created); // append locally — don't reload (would drop other rows' unsaved edits)
            await OnChanged.InvokeAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveAsync(QuestionAdminDto t)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.UpdateQuestionAsync(Activity.Id, t.Id, new QuestionUpsertRequest
            {
                Order = t.Order,
                Text = string.IsNullOrWhiteSpace(t.Text) ? $"Track {t.Order}" : t.Text,
                Kind = QuestionKind.FreeText,
                Points = Math.Max(0, t.Points),
                SpotifyUrl = t.SpotifyUrl,
                AcceptedFreeTextAnswer = t.AcceptedFreeTextAnswer,
                AcceptedArtist = t.AcceptedArtist,
                ReleaseYear = t.ReleaseYear,
            });
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(QuestionAdminDto t)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DeleteQuestionAsync(Activity.Id, t.Id);
            _tracks.Remove(t);
            await OnChanged.InvokeAsync();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
