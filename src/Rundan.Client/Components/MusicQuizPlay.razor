@inject RundanApi Api
@implements IDisposable

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div>Loading tracks…</div>
}
else if (_tracks.Count == 0)
{
    <div class="card muted">No tracks yet — the host is still setting up.</div>
}
else
{
    <div class="card stack">
        <h2 style="margin:0">Music quiz</h2>
        <p class="muted" style="margin:0;font-size:.85rem">
            The host plays the tracks one at a time — @(Activity.MusicChoices ? "tap the artist" : "type the song and the artist") when each one appears. @_answered.Count of @_tracks.Count answered.
        </p>
        @if (_error is not null)
        {
            <div class="alert error">@_error</div>
        }
    </div>

    @foreach (var (q, i) in _tracks.Select((q, i) => (q, i)))
    {
        // One by one: only show a track once the host has played it (or we've already answered it).
        if (!IsRevealed(q)) { continue; }
        var mine = _answered.GetValueOrDefault(q.Id);
        var res = _results.GetValueOrDefault(q.Id);
        var rem = mine is null ? LiveRemaining(q) : null;
        // Kahoot-style is timed — once the window closes the options lock and "time's up" shows.
        var timeUp = mine is null && IsChoice(q) && _live.ContainsKey(q.Id) && rem is null;
        <div class="card stack">
            <div class="row">
                <b class="grow">Track @(i + 1)@(HasLabel(q, i) ? $" · {q.Text}" : "")</b>
                @if (rem is int r && (Activity.SpeedScoring || IsChoice(q)))
                {
                    <span class="badge" style="background:var(--green-100);color:var(--green-700)">⏱ @(Activity.SpeedScoring ? $"answer fast · {r} s" : $"{r} s left")</span>
                }
                else if (timeUp)
                {
                    <span class="badge" style="background:var(--red-100,#fde8e8);color:var(--red-700,#b42318)">⏰ Time's up</span>
                }
                <span class="muted" style="font-size:.8rem">@q.Points pt each</span>
            </div>

            @if (mine is null && IsChoice(q) && !timeUp)
            {
                @* Kahoot-style: tap the artist. *@
                @for (var oi = 0; oi < q.Options.Count; oi++)
                {
                    var opt = q.Options[oi];
                    var idx = oi;
                    <button class="option" style="--opt-accent:@QuizPlay.KeyColor(idx, q.Options.Count)"
                            disabled="@_busy" @onclick="() => SubmitChoiceAsync(q.Id, opt.Text)">
                        <span class="option__key">@QuizPlay.OptionKey(idx, q.Options.Count)</span>
                        <span class="option__text">@opt.Text</span>
                        <span class="option__mark"></span>
                    </button>
                }
            }
            else if (timeUp)
            {
                <div class="alert">⏰ Time's up — you didn't lock in an answer for this track.</div>
            }
            else if (mine is null)
            {
                <input placeholder="Song title" value="@_song.GetValueOrDefault(q.Id)"
                       @oninput="e => _song[q.Id] = e.Value?.ToString() ?? string.Empty" />
                <input placeholder="Artist" value="@_artist.GetValueOrDefault(q.Id)"
                       @oninput="e => _artist[q.Id] = e.Value?.ToString() ?? string.Empty" />
                @if (q.AsksYear)
                {
                    <input type="number" min="1860" max="2100" placeholder="Release year" value="@_year.GetValueOrDefault(q.Id)"
                           @oninput="e => _year[q.Id] = e.Value?.ToString() ?? string.Empty" />
                }
                <button class="btn block success" @onclick="() => SubmitAsync(q.Id)"
                        disabled="@(_busy || !HasGuess(q))">
                    Lock in
                </button>
            }
            else
            {
                <div class="alert @(mine.AwardedPoints > 0 ? "success" : "")">
                    <div>
                        You said — Song: <b>@Shown(mine.FreeText)</b> · Artist: <b>@Shown(mine.ArtistText)</b>@(q.AsksYear ? $" · Year: {(mine.Year?.ToString() ?? "—")}" : "")
                    </div>
                    @if (res is not null)
                    {
                        <div style="margin-top:.25rem">
                            Song @(res.SongCorrect ? "✓" : "✗")@(string.IsNullOrWhiteSpace(res.CorrectSong) ? "" : $" — {res.CorrectSong}")
                            · Artist @(res.ArtistCorrect ? "✓" : "✗")@(string.IsNullOrWhiteSpace(res.CorrectArtist) ? "" : $" — {res.CorrectArtist}")
                            @if (res.CorrectYear is int cy)
                            {
                                <text> · Year @(res.YearPoints > 0 ? "✓" : "✗") — @cy</text>
                            }
                        </div>
                    }
                    <div style="margin-top:.25rem"><b>+@mine.AwardedPoints</b></div>
                </div>
            }
        </div>
    }

    @if (RevealedCount == 0)
    {
        <div class="card center muted" style="padding:1.1rem"><div class="spinner" style="margin:.4rem auto"></div>Waiting for the host to play the first track…</div>
    }
    else if (RevealedCount < _tracks.Count)
    {
        <div class="card center muted" style="font-size:.85rem">⏯ Waiting for the host to play the next track — @(_tracks.Count - RevealedCount) to go.</div>
    }
}

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;
    [Parameter] public PlayerSession Session { get; set; } = default!;

    /// <summary>The activity's live connection — used to receive the host's "track started" cue so the
    /// fastest-to-answer countdown ticks for everyone.</summary>
    [Parameter] public ScoreboardConnection? Connection { get; set; }

    // Per-track live start + window (from the question's StartedUtc on load, then SignalR while playing).
    private readonly Dictionary<int, (DateTimeOffset Start, int Window)> _live = new();
    private ScoreboardConnection? _subscribed;
    private System.Threading.Timer? _ticker;
    private System.Threading.Timer? _poll;
    private bool _polling;
    private bool _disposed;

    // Seconds left in the speed window for a track, or null if it isn't live right now.
    private int? LiveRemaining(QuestionDto q)
    {
        if (!_live.TryGetValue(q.Id, out var l))
        {
            return null;
        }

        var rem = l.Window - (int)(DateTimeOffset.UtcNow - l.Start).TotalSeconds;
        return rem > 0 ? rem : null;
    }

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<QuestionDto> _tracks = new();
    private readonly Dictionary<int, MyAnswerDto> _answered = new();
    private readonly Dictionary<int, AnswerResultDto> _results = new();
    private readonly Dictionary<int, string> _song = new();
    private readonly Dictionary<int, string> _artist = new();
    private readonly Dictionary<int, string> _year = new();

    private static bool HasLabel(QuestionDto q, int i) =>
        !string.IsNullOrWhiteSpace(q.Text) && q.Text != $"Track {i + 1}";

    // Enable "Lock in" once the player has typed at least one of song / artist / (year, when asked).
    private bool HasGuess(QuestionDto q) =>
        !string.IsNullOrWhiteSpace(_song.GetValueOrDefault(q.Id))
        || !string.IsNullOrWhiteSpace(_artist.GetValueOrDefault(q.Id))
        || (q.AsksYear && int.TryParse(_year.GetValueOrDefault(q.Id), out _));

    // Multiple-choice ("pick the artist") track: the host enabled it and we have the options.
    private bool IsChoice(QuestionDto q) => Activity.MusicChoices && q.Options.Count > 0;

    // A track is shown to the player once the host has started it (or we've already answered it).
    private bool IsRevealed(QuestionDto q) => _answered.ContainsKey(q.Id) || _live.ContainsKey(q.Id);

    private int RevealedCount => _tracks.Count(IsRevealed);

    // Tapping an artist option submits it as the artist guess (reuses the artist-match scoring).
    private Task SubmitChoiceAsync(int questionId, string artist)
    {
        _artist[questionId] = artist;
        _song[questionId] = string.Empty;
        _year[questionId] = string.Empty;
        return SubmitAsync(questionId);
    }

    private static string Shown(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tracks = await Api.GetQuestionsAsync(Activity.Id);
            var mine = await Api.GetMyAnswersAsync(Activity.Id, Session.Token);
            foreach (var a in mine)
            {
                _answered[a.QuestionId] = a;
            }

            // A track the host already started before we loaded — pick up its live countdown.
            foreach (var q in _tracks.Where(q => q.StartedUtc is not null))
            {
                _live[q.Id] = (q.StartedUtc!.Value, 30);
            }

            if (_live.Count > 0) EnsureTicking();

            // Reveal is driven by the host's live "track started" cue. Live updates can be missed (a flaky
            // connection) or unavailable (e.g. WebSockets blocked), so also poll for newly-started tracks
            // until every track is showing — that way the UI reveals on its own without a manual refresh.
            if (RevealedCount < _tracks.Count) EnsurePolling();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    protected override void OnParametersSet()
    {
        // Subscribe to the host's live "track started" cue (re-subscribe if the connection changes).
        if (ReferenceEquals(_subscribed, Connection))
        {
            return;
        }

        if (_subscribed is not null) _subscribed.MusicTrackStarted -= OnTrackStarted;
        _subscribed = Connection;
        if (_subscribed is not null) _subscribed.MusicTrackStarted += OnTrackStarted;
    }

    private void OnTrackStarted(MusicTrackStartedDto t) => _ = InvokeAsync(() =>
    {
        if (t.ActivityId != Activity.Id) return;
        _live[t.QuestionId] = (t.StartedUtc, t.WindowSeconds);
        EnsureTicking();
        StateHasChanged();
    });

    // Re-render a few times a second while a track is live so the countdown ticks; stop when none are.
    private void EnsureTicking() =>
        _ticker ??= new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            if (_disposed) return; // short-circuit a callback queued just before teardown
            if (_tracks.All(q => LiveRemaining(q) is null))
            {
                _ticker?.Dispose();
                _ticker = null;
            }

            StateHasChanged();
        }), null, 500, 500);

    // Poll the server for tracks the host has started, in case a live cue was missed. Stops once every
    // track is revealed. A no-op while a previous poll is still in flight or after teardown.
    private void EnsurePolling() =>
        _poll ??= new System.Threading.Timer(_ => _ = PollStartedAsync(), null, 3000, 3000);

    private async Task PollStartedAsync()
    {
        if (_disposed || _polling)
        {
            return;
        }

        _polling = true;
        try
        {
            var fresh = await Api.GetQuestionsAsync(Activity.Id);
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                var changed = false;
                foreach (var q in fresh.Where(q => q.StartedUtc is not null && !_live.ContainsKey(q.Id)))
                {
                    _live[q.Id] = (q.StartedUtc!.Value, 30);
                    changed = true;
                }

                if (changed)
                {
                    EnsureTicking();
                    StateHasChanged();
                }

                if (RevealedCount >= _tracks.Count) // everything's showing — no need to keep polling
                {
                    _poll?.Dispose();
                    _poll = null;
                }
            });
        }
        catch { /* transient — try again next tick */ }
        finally { _polling = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        _ticker?.Dispose();
        _poll?.Dispose();
        if (_subscribed is not null) _subscribed.MusicTrackStarted -= OnTrackStarted;
    }

    private async Task SubmitAsync(int questionId)
    {
        var song = _song.GetValueOrDefault(questionId, string.Empty).Trim();
        var artist = _artist.GetValueOrDefault(questionId, string.Empty).Trim();
        int? year = int.TryParse(_year.GetValueOrDefault(questionId), out var y) ? y : null;
        if (song.Length == 0 && artist.Length == 0 && year is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var res = await Api.SubmitAnswerAsync(
                Activity.Id, new SubmitAnswerRequest { QuestionId = questionId, FreeText = song, ArtistText = artist, Year = year }, Session.Token);
            _results[questionId] = res;
            _answered[questionId] = new MyAnswerDto
            {
                QuestionId = questionId,
                FreeText = song,
                ArtistText = artist,
                Year = year,
                IsCorrect = res.IsCorrect,
                AwardedPoints = res.AwardedPoints,
            };
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
