@inject RundanApi Api
@inject AppState State

<div class="card stack">
    <div class="row">
        <h2 class="grow">Tournament</h2>
        @if (CanManage && (_bracket?.Drawn ?? false))
        {
            <button class="btn ghost small danger" @onclick="ResetAsync" disabled="@_busy">Reset</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }

    @if (_bracket is null || !_bracket.Drawn)
    {
        @* ---- Pre-draw: optional manual seeding, then the draw ---- *@
        @if (CanManage && Activity.UseManualSeeding && _seeds.Count > 1)
        {
            <h3>Seed the teams</h3>
            <p class="muted" style="font-size:.85rem">
                Rank the teams (1 = top seed). @(Activity.UseGroupStage
                    ? "Seeds are spread across the groups."
                    : "The bracket is built so the top seed meets the lowest.")
            </p>
            <ol class="list">
                @for (var i = 0; i < _seeds.Count; i++)
                {
                    var idx = i;
                    <li>
                        <span class="badge">@(idx + 1)</span>
                        <span class="grow">@_seeds[idx].Name</span>
                        <button class="btn ghost small" @onclick="() => MoveSeed(idx, -1)" disabled="@(idx == 0)">▲</button>
                        <button class="btn ghost small" @onclick="() => MoveSeed(idx, 1)" disabled="@(idx == _seeds.Count - 1)">▼</button>
                    </li>
                }
            </ol>
        }

        @if (_bracket is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (CanManage)
        {
            <button class="btn block success" @onclick="DrawAsync" disabled="@_busy">
                @(Activity.UseGroupStage ? "Draw the groups" : "Draw the teams")
            </button>
        }
        else
        {
            <p class="muted">Waiting for the host to draw the matches.</p>
        }
    }
    else
    {
        @* ---- Group stage ---- *@
        @if (_bracket.HasGroupStage)
        {
            <h3>Group stage</h3>
            @if (!_bracket.GroupStageComplete)
            {
                <p class="muted" style="font-size:.85rem">Play out every group match — the playoffs are seeded automatically once they're all in.</p>
            }

            @foreach (var g in _bracket.Groups)
            {
                <div class="stack" style="gap:.4rem">
                    <h4 style="margin:.25rem 0">Group @(g.GroupIndex + 1)</h4>
                    <table class="grp">
                        <thead>
                            <tr><th>#</th><th style="text-align:left">Team</th><th>P</th><th>W</th><th>L</th><th>+/−</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in g.Rows)
                            {
                                <tr>
                                    <td>@row.Rank</td>
                                    <td style="text-align:left">@row.Name</td>
                                    <td>@row.Played</td>
                                    <td>@row.Won</td>
                                    <td>@row.Lost</td>
                                    <td>@(row.Diff > 0 ? "+" : "")@row.Diff</td>
                                    <td>@AdvanceBadge(row.AdvancesToPool)</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @{ var gm = GroupMatches(g.GroupIndex).ToList(); }
                    @if (gm.Any(m => !m.Decided))
                    {
                        <ul class="list">
                            @foreach (var m in gm)
                            {
                                @RenderRow(m)
                            }
                        </ul>
                    }
                </div>
            }
        }

        @* ---- Playoff brackets (A = championship, B = plate) ---- *@
        @foreach (var pool in PoolsPresent())
        {
            var champ = pool == 0 ? _bracket.ChampionName : _bracket.PlayoffBChampionName;
            <h3>@PoolLabel(pool)</h3>
            @if (!string.IsNullOrEmpty(champ))
            {
                <div class="alert success">@(pool == 0 ? "Champion" : "Plate winner"): <b>@champ</b></div>
            }

            <h4 style="margin:.25rem 0">Winners</h4>
            <div class="bracket">
                @foreach (var r in PoolRounds(pool, BracketSide.Winners))
                {
                    <div class="round">
                        @foreach (var m in PoolMatches(pool, BracketSide.Winners, r))
                        {
                            @RenderMatch(m)
                        }
                    </div>
                }
            </div>

            @if (PoolMatches(pool, BracketSide.Losers).Any())
            {
                <h4 style="margin:.25rem 0">Consolation</h4>
                <div class="bracket">
                    @foreach (var r in PoolRounds(pool, BracketSide.Losers))
                    {
                        <div class="round">
                            @foreach (var m in PoolMatches(pool, BracketSide.Losers, r))
                            {
                                @RenderMatch(m)
                            }
                        </div>
                    }
                </div>
            }
        }

        @if (Playable().Any())
        {
            <h3>Order of play</h3>
            <ul class="list">
                @foreach (var m in Playable())
                {
                    <li>
                        @if (!string.IsNullOrEmpty(m.CourtName))
                        {
                            <span class="badge">@m.CourtName</span>
                        }
                        <span class="grow">@(m.AName ?? "—") vs @(m.IsBye ? "(walkover)" : m.BName ?? "—")</span>
                        <span class="muted" style="font-size:.85rem">@StageTag(m)</span>
                    </li>
                }
            </ul>
        }

        <p class="muted" style="font-size:.8rem">@ScoringLegend()</p>
    }
</div>

@if (_resultMatch is { } rm)
{
    <div style="position:fixed;inset:0;background:rgba(15,23,42,.45);display:flex;align-items:center;justify-content:center;padding:1rem;z-index:60"
         @onclick="CancelResult">
        <div class="card stack" style="max-width:440px;width:100%" @onclick:stopPropagation="true">
            <div class="row">
                <h3 class="grow">Enter result</h3>
                <button class="btn ghost small" @onclick="CancelResult">Close</button>
            </div>
            <div class="row" style="font-weight:600">
                <span class="grow">@(rm.AName ?? "—")</span>
                <span class="muted">vs</span>
                <span class="grow" style="text-align:right">@(rm.BName ?? "—")</span>
            </div>

            @if (SelFormat == MatchFormat.Sets)
            {
                <p class="muted" style="font-size:.8rem">
                    Best of @SelBestOf sets · first to @SelGames wins a set · @SetsToWin to take the match.
                </p>
            }

            @if (_resultError is not null)
            {
                <div class="alert error">@_resultError</div>
            }

            @for (var i = 0; i < RowCount; i++)
            {
                var idx = i;
                <div class="row" style="align-items:center;gap:.5rem">
                    @if (SelFormat == MatchFormat.Sets)
                    {
                        <span class="muted" style="width:52px;font-size:.85rem">Set @(idx + 1)</span>
                    }
                    <input class="grow" type="number" min="0" max="100" style="text-align:center" @bind="_scoreA[idx]" />
                    <span class="muted">–</span>
                    <input class="grow" type="number" min="0" max="100" style="text-align:center" @bind="_scoreB[idx]" />
                </div>
            }

            <div class="row" style="align-items:center">
                <span class="grow muted" style="font-size:.9rem">@WinnerPreviewText</span>
                <button class="btn success" @onclick="SaveResultAsync" disabled="@(_busy || WinnerId() is null)">Save result</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;
    [Parameter] public int RefreshKey { get; set; }

    // Per-event management (draw / record / reset / seed) — the server gates these the same way via
    // Activity.CanManage (admin of this event, the site host, or open when the event has no admins).
    private bool CanManage => !State.PreviewAsPlayer && (State.HasAdminCode || Activity.CanManage);

    private BracketDto? _bracket;
    private List<TeamSeedDto> _seeds = new();
    private bool _busy;
    private string? _error;
    private int _loadedActivityId = -1;
    private int _lastRefreshKey = -1;

    // Result-entry popup state.
    private BracketMatchDto? _resultMatch;
    private int[] _scoreA = Array.Empty<int>();
    private int[] _scoreB = Array.Empty<int>();
    private string? _resultError;

    // The selected match's format (group matches can be shorter than the playoffs).
    private bool SelGroup => _resultMatch?.GroupIndex != null;
    private MatchFormat SelFormat => SelGroup ? Activity.GroupMatchFormat : Activity.MatchFormat;
    private int SelBestOf => SelGroup ? Math.Max(1, Activity.GroupBestOfSets) : Math.Max(1, Activity.BestOfSets);
    private int SelGames => SelGroup ? Activity.GroupGamesToWinSet : Activity.GamesToWinSet;
    private int RowCount => SelFormat == MatchFormat.Sets ? SelBestOf : 1;
    private int SetsToWin => SelBestOf / 2 + 1;

    // ---- Group / pool helpers ----
    private IEnumerable<BracketMatchDto> GroupMatches(int groupIndex) => _bracket!.Matches
        .Where(m => m.GroupIndex == groupIndex).OrderBy(m => m.Round).ThenBy(m => m.Slot);

    private IEnumerable<int> PoolsPresent() => _bracket!.Matches
        .Where(m => m.GroupIndex == null).Select(m => m.Pool).Distinct().OrderBy(p => p);

    private IEnumerable<int> PoolRounds(int pool, BracketSide side) => _bracket!.Matches
        .Where(m => m.GroupIndex == null && m.Pool == pool && m.Side == side)
        .Select(m => m.Round).Distinct().OrderBy(r => r);

    private IEnumerable<BracketMatchDto> PoolMatches(int pool, BracketSide side) => _bracket!.Matches
        .Where(m => m.GroupIndex == null && m.Pool == pool && m.Side == side);

    private IEnumerable<BracketMatchDto> PoolMatches(int pool, BracketSide side, int round) =>
        PoolMatches(pool, side).Where(m => m.Round == round).OrderBy(m => m.Slot);

    private IEnumerable<BracketMatchDto> Playable() => _bracket!.Matches
        .Where(m => m.Ready && !m.Decided)
        .OrderBy(m => m.GroupIndex.HasValue ? m.GroupIndex.Value : 1000)
        .ThenBy(m => m.Pool).ThenBy(m => (int)m.Side).ThenBy(m => m.Round).ThenBy(m => m.Slot);

    private string PoolLabel(int pool) => _bracket!.HasGroupStage ? (pool == 0 ? "Playoff A" : "Playoff B")
        : "Knockout";

    private string StageTag(BracketMatchDto m) => m.GroupIndex is int g
        ? $"Group {g + 1}"
        : $"{PoolLabel(m.Pool).Replace("Playoff ", "")}{(m.Side == BracketSide.Winners ? "W" : "L")}{m.Round}";

    private RenderFragment AdvanceBadge(int? pool) => builder =>
    {
        if (pool is null)
        {
            return;
        }

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "badge");
        builder.AddAttribute(2, "style", pool == 0 ? "background:var(--green-100);color:var(--green-700)" : "");
        builder.AddContent(3, pool == 0 ? "→ A" : "→ B");
        builder.CloseElement();
    };

    private string ScoringLegend()
    {
        if (Activity.TournamentScoring == TournamentScoring.Placement)
        {
            return "Scoring: teams are ranked by how far they got and scored by final placement — fed into the scoreboard above.";
        }

        return _bracket!.HasGroupStage
            ? "Points: 1 per group win, 3 per Playoff A win, 2 per Playoff B win, 1 per consolation win — fed into the scoreboard above."
            : "Points: 3 per winners'-side win, 1 per consolation win — fed into the scoreboard above.";
    }

    // A compact pickable row (used for round-robin group matches and the order of play).
    private RenderFragment RenderRow(BracketMatchDto m) =>
    @<li>
        @if (!string.IsNullOrEmpty(m.CourtName))
        {
            <span class="badge">@m.CourtName</span>
        }
        <span class="grow">@(m.AName ?? "—") vs @(m.BName ?? "—")</span>
        @if (m.Decided)
        {
            <span class="muted" style="font-size:.85rem">@WinnerName(m)@(string.IsNullOrEmpty(m.Score) ? "" : $" · {m.Score}")</span>
        }
        else if (CanPick(m, m.AId))
        {
            <button class="btn small success" @onclick="() => OpenResult(m)">Enter</button>
        }
    </li>;

    private RenderFragment RenderMatch(BracketMatchDto m) =>
    @<div class="match">
        @if (!string.IsNullOrEmpty(m.CourtName))
        {
            <div class="bk-court">@m.CourtName</div>
        }
        @RenderTeam(m, m.AId, m.AName)
        @RenderTeam(m, m.BId, m.BName)
        @if (!string.IsNullOrEmpty(m.Score))
        {
            <div class="bk-score muted" style="font-size:.78rem;text-align:center">@m.Score</div>
        }
    </div>;

    private RenderFragment RenderTeam(BracketMatchDto m, int? id, string? name) =>
    @<text>
        @if (CanPick(m, id))
        {
            <button class="bk-team pick" @onclick="() => OpenResult(m)">@(name ?? "—")</button>
        }
        else
        {
            <div class="bk-team @TeamCls(m, id)">@(m.IsBye && id is null ? "(walkover)" : name ?? "—")</div>
        }
    </text>;

    private bool CanPick(BracketMatchDto m, int? id)
        => CanManage && !_busy && m.Ready && !m.Decided && id.HasValue;

    private string TeamCls(BracketMatchDto m, int? id)
    {
        if (id is null)
        {
            return "empty";
        }

        return m.WinnerParticipantId == id ? "win" : m.Decided ? "lose" : string.Empty;
    }

    private string WinnerName(BracketMatchDto m) =>
        (m.WinnerParticipantId == m.AId ? m.AName : m.BName) ?? "—";

    private void OpenResult(BracketMatchDto m)
    {
        _resultMatch = m;
        _scoreA = new int[RowCount];
        _scoreB = new int[RowCount];
        _resultError = null;
    }

    private void CancelResult()
    {
        _resultMatch = null;
        _resultError = null;
    }

    // The winner implied by the current inputs, or null if not yet decided (mirrors the server rule).
    private int? WinnerId()
    {
        if (_resultMatch is not { } m)
        {
            return null;
        }

        if (SelFormat == MatchFormat.Sets)
        {
            int a = 0, b = 0;
            for (var i = 0; i < RowCount; i++)
            {
                if (_scoreA[i] > _scoreB[i]) a++;
                else if (_scoreB[i] > _scoreA[i]) b++;
            }

            if (a >= SetsToWin) return m.AId;
            if (b >= SetsToWin) return m.BId;
            return null;
        }

        if (_scoreA[0] == _scoreB[0]) return null;
        return _scoreA[0] > _scoreB[0] ? m.AId : m.BId;
    }

    private string WinnerPreviewText
    {
        get
        {
            var id = WinnerId();
            if (id is null)
            {
                return SelFormat == MatchFormat.Sets ? "Enter the set scores" : "Enter the score";
            }

            var name = id == _resultMatch!.AId ? _resultMatch.AName : _resultMatch.BName;
            return $"Winner: {name}";
        }
    }

    private async Task SaveResultAsync()
    {
        if (_resultMatch is not { } m || WinnerId() is null)
        {
            return;
        }

        var sets = new List<MatchSetInputDto>();
        for (var i = 0; i < RowCount; i++)
        {
            // Skip unplayed trailing sets (0–0); a real set always has a score.
            if (_scoreA[i] != 0 || _scoreB[i] != 0)
            {
                sets.Add(new MatchSetInputDto { A = _scoreA[i], B = _scoreB[i] });
            }
        }

        _busy = true;
        _resultError = null;
        try
        {
            _bracket = await Api.RecordBracketResultAsync(Activity.Id, m.Id, sets);
            _resultMatch = null;
        }
        catch (ApiException ex)
        {
            _resultError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void MoveSeed(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _seeds.Count)
        {
            return;
        }

        (_seeds[index], _seeds[target]) = (_seeds[target], _seeds[index]);
    }

    protected override async Task OnParametersSetAsync()
    {
        var activityChanged = Activity.Id != _loadedActivityId;
        if (activityChanged || RefreshKey != _lastRefreshKey)
        {
            _loadedActivityId = Activity.Id;
            _lastRefreshKey = RefreshKey;
            // A RefreshKey bump is a background SignalR scoreboard push — refresh the bracket but DON'T
            // refetch the seed order, or it would wipe the host's in-progress drag ordering (which lives
            // only client-side until they press Draw) every time a player joins the lobby.
            await LoadAsync(reloadSeeds: activityChanged);
        }
    }

    private async Task LoadAsync(bool reloadSeeds = true)
    {
        try { _bracket = await Api.GetBracketAsync(Activity.Id); }
        catch (ApiException ex) { _error = ex.Message; }

        // Load the seed order for the pre-draw editor (host + manual seeding only). Only on a genuine
        // (re)load or when we have nothing yet — never on a background RefreshKey refresh.
        if (CanManage && Activity.UseManualSeeding && _bracket is { Drawn: false }
            && (reloadSeeds || _seeds.Count == 0))
        {
            try { _seeds = await Api.GetSeedsAsync(Activity.Id); } catch (ApiException) { _seeds = new(); }
        }
    }

    private async Task DrawAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // Persist the chosen seed order first, then draw from it.
            if (Activity.UseManualSeeding && _seeds.Count > 1)
            {
                await Api.SetSeedsAsync(Activity.Id, _seeds.Select(s => s.TeamId).ToList());
            }

            _bracket = await Api.DrawBracketAsync(Activity.Id);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _bracket = await Api.ResetBracketAsync(Activity.Id);
            if (CanManage && Activity.UseManualSeeding)
            {
                try { _seeds = await Api.GetSeedsAsync(Activity.Id); } catch (ApiException) { }
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
