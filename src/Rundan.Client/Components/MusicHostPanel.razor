@inject RundanApi Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="card stack accent">
    <h2 style="margin:0">Tracks to play (host)</h2>
    <p class="muted" style="margin:0;font-size:.85rem">
        @(CanPlayInApp
            ? "Play full tracks here with your Spotify Premium connection, or open them in Spotify. "
            : "Play each one out loud. ")
        Hit <b>Start</b> to reveal a track to the players@(Activity.SpeedScoring
            ? $" and begin a fastest-to-answer round — a correct answer scores more the quicker it comes in (the bonus fades over {_window} s)."
            : ".")
        Players only see a track once you start it, and in tap-the-artist mode their options lock when the
        timer runs out. This panel is yours alone.
    </p>

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }
    @if (_playError is not null)
    {
        <div class="alert error">@_playError</div>
    }

    @if (CanPlayInApp && _playingId is not null)
    {
        <div class="row" style="gap:.5rem;align-items:center;background:var(--card-2,#f3f0ea);border-radius:10px;padding:.4rem .6rem">
            <span class="grow"><b>♪ Playing</b> @PlayingLabel</span>
            <button class="btn small" @onclick="TogglePauseAsync" disabled="@_playBusy">@(_paused ? "▶ Resume" : "⏸ Pause")</button>
        </div>
    }

    <ul class="list">
        @foreach (var (t, i) in _tracks.Select((t, i) => (t, i)))
        {
            var live = _liveId == t.Id;
            <li style="flex-direction:column;align-items:stretch;gap:.3rem">
                <div class="row">
                    <b class="grow">Track @(i + 1)</b>
                    @if (live)
                    {
                        <span class="badge" style="background:var(--green-100);color:var(--green-700)">▶ LIVE · @Remaining s</span>
                    }
                    <button class="btn small @(live ? "secondary" : "success")" @onclick="() => StartAsync(t)" disabled="@_busy">
                        @(live ? "Restart" : "Start")
                    </button>
                    @if (CanPlayInApp && !string.IsNullOrWhiteSpace(t.SpotifyUrl))
                    {
                        <button class="btn small" @onclick="() => PlayAsync(t)" disabled="@_playBusy">▶ Play</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.SpotifyUrl))
                    {
                        <a class="btn small ghost" href="@t.SpotifyUrl" target="_blank" rel="noopener">Spotify ↗</a>
                    }
                </div>
                <div class="muted" style="font-size:.82rem">
                    @if (t.Hidden)
                    {
                        <text>Answer hidden while you play</text>
                    }
                    else
                    {
                        <text>Answer: <b>@(string.IsNullOrWhiteSpace(t.AcceptedFreeTextAnswer) ? "—" : t.AcceptedFreeTextAnswer)</b> by <b>@(string.IsNullOrWhiteSpace(t.AcceptedArtist) ? "—" : t.AcceptedArtist)</b>@(t.ReleaseYear is int yr ? $" · {yr}" : "")</text>
                    }
                    · <b>@t.Points pt</b>
                </div>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;

    private List<QuestionAdminDto> _tracks = new();
    private string? _error;
    private bool _busy;

    // ---- fastest-to-answer (live) ----
    private int? _liveId;
    private DateTimeOffset _liveStart;
    private int _window = 30;
    private System.Threading.Timer? _ticker;
    private bool _disposed;
    private int Remaining => Math.Max(0, _window - (int)(DateTimeOffset.UtcNow - _liveStart).TotalSeconds);

    // ---- in-app playback (Web Playback SDK) ----
    private bool CanPlayInApp => Activity.SpotifyConnectionId is not null;
    private IJSObjectReference? _playerModule;
    private DotNetObjectReference<MusicHostPanel>? _playerRef;
    private int? _playingId;
    private bool _paused;
    private bool _playBusy;
    private string? _playError;
    private string PlayingLabel => _tracks.FindIndex(t => t.Id == _playingId) is var ix && ix >= 0 ? $"Track {ix + 1}" : "";

    protected override async Task OnInitializedAsync()
    {
        try { _tracks = await Api.GetAdminQuestionsAsync(Activity.Id); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    // ---- fastest-to-answer ----
    private async Task StartAsync(QuestionAdminDto t)
    {
        _busy = true;
        _error = null;
        try
        {
            var res = await Api.StartMusicTrackAsync(Activity.Id, t.Id);
            _liveId = res.QuestionId;
            _liveStart = res.StartedUtc;
            _window = res.WindowSeconds;
            EnsureTicking();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void EnsureTicking() =>
        _ticker ??= new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            if (_liveId is null || Remaining <= 0)
            {
                var justEnded = _liveId is not null; // a track's window ran out this tick
                _liveId = null;
                _ticker?.Dispose();
                _ticker = null;
                if (justEnded)
                {
                    // The clock ran out on a track — ask the server to wrap up if that was the last one.
                    _ = MaybeFinishAsync();
                }
            }

            StateHasChanged();
        }), null, 500, 500);

    private async Task MaybeFinishAsync()
    {
        try { await Api.MaybeFinishMusicAsync(Activity.Id); }
        catch (ApiException) { /* best effort — the host can also finish manually */ }
    }

    // ---- in-app playback ----
    private async Task PlayAsync(QuestionAdminDto t)
    {
        if (Activity.SpotifyConnectionId is null || string.IsNullOrWhiteSpace(t.SpotifyUrl))
        {
            return;
        }

        _playBusy = true;
        _playError = null;
        try
        {
            _playerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/spotify-player.js");
            _playerRef ??= DotNetObjectReference.Create(this);
            var ready = await _playerModule.InvokeAsync<bool>("init", _playerRef);
            if (!ready)
            {
                _playError = "Couldn't start the in-app player — make sure the connected account is Spotify Premium. You can still use the “Spotify ↗” link.";
                return;
            }

            var ok = await _playerModule.InvokeAsync<bool>("play", t.SpotifyUrl);
            if (ok)
            {
                _playingId = t.Id;
                _paused = false;
            }
            else
            {
                _playError = "Spotify wouldn't start that track. Try the “Spotify ↗” link.";
            }
        }
        catch (Exception ex) { _playError = ex.Message; }
        finally { _playBusy = false; }
    }

    private async Task TogglePauseAsync()
    {
        if (_playerModule is null)
        {
            return;
        }

        _playBusy = true;
        try
        {
            await _playerModule.InvokeVoidAsync(_paused ? "resume" : "pause");
            _paused = !_paused;
        }
        catch { /* best effort */ }
        finally { _playBusy = false; }
    }

    /// <summary>Called by the Web Playback SDK (via JS) to get a fresh access token for this activity's connection.</summary>
    [JSInvokable]
    public async Task<string?> GetSpotifyTokenJs()
    {
        if (Activity.SpotifyConnectionId is not { } cid)
        {
            return null;
        }

        try { return await Api.GetSpotifyTokenAsync(cid); }
        catch (ApiException) { return null; }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ticker?.Dispose();
        try
        {
            if (_playerModule is not null)
            {
                await _playerModule.InvokeVoidAsync("disconnect");
                await _playerModule.DisposeAsync();
            }
        }
        catch { /* navigating away */ }
        _playerRef?.Dispose();
    }
}
