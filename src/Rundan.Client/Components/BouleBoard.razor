@inject RundanApi Api
@inject AppState State
@implements IDisposable

<div class="card stack">
    <div class="row">
        <h2 class="grow">Record scores</h2>
        @* Per-player format is one score per player (no rounds); team format steps through the set rounds. *@
        @if (!PerPlayer && MaxRound > 1)
        {
            <div class="row" style="gap:.4rem">
                <span class="muted">Round of @MaxRound</span>
                <div class="stepper" style="width:auto">
                    <button @onclick="() => SetRound(_round - 1)" disabled="@(_round <= 1)">−</button>
                    <span class="value" style="min-width:2ch;font-size:1.3rem">@_round</span>
                    <button @onclick="() => SetRound(_round + 1)" disabled="@(_round >= MaxRound)">+</button>
                </div>
            </div>
        }
    </div>

    @if (StructureNote() is { } note)
    {
        <div class="muted" style="font-size:.85rem">@note</div>
    }

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }

    @if (!IsPoints)
    {
        @* Measured game: one value per team (time mm:ss / length mm), latest reading replaces. *@
        @if (Units().Count == 0)
        {
            <p class="muted">No players have joined yet.</p>
        }
        else
        {
            @foreach (var u in Units())
            {
                var key = $"{u.Id}";
                var pending = _pending.GetValueOrDefault(key, 0);
                var has = UnitCount(u.Id) > 0;
                <div class="row" style="border-bottom:1px solid var(--line);padding:.5rem 0">
                    <span class="grow"><b>@u.Name</b>@(has ? $" · {Format(UnitValue(u.Id))}" : "")</span>
                    @if (Activity.MeasuresTime)
                    {
                        <button class="btn ghost small" @onclick="() => ToggleStopwatch(key)" disabled="@RemoteRunning(key)">@(IsRunning(key) ? "Stop" : "Start")</button>
                    }
                    @if (Activity.MeasuresTime && IsRunning(key))
                    {
                        <span style="font-variant-numeric:tabular-nums;font-size:1.15rem;font-weight:600;min-width:60px;text-align:right">@Clock(Elapsed(key))</span>
                    }
                    else if (Activity.MeasuresTime && RemoteRunning(key))
                    {
                        @* Another scorekeeper is timing this now — tick along, read-only. *@
                        <span style="font-variant-numeric:tabular-nums;font-size:1.15rem;font-weight:600;min-width:60px;text-align:right;color:var(--green-700)" title="Someone is timing this now">⏱ @Clock(RemoteElapsed(key))</span>
                    }
                    else
                    {
                        <input type="number" min="0" max="100000" step="any" style="width:84px" value="@Fmt.Num(pending)" @onchange="e => SetPending(key, e)" />
                        <span class="muted">@UnitSuffix</span>
                    }
                    <button class="btn small success" @onclick="() => RecordSingleAsync(u.Id, key)" disabled="@(_busy || pending <= 0 || RemoteRunning(key))">Set</button>
                </div>
            }
        }
    }
    else if (_teams.Count > 0)
    {
        @* Event activity — teams (and per-player entry when configured) *@
        @foreach (var team in _teams)
        {
            @if (PerPlayer)
            {
                <div style="border-bottom:1px solid var(--line);padding:.5rem 0">
                    <b>@team.Name</b>
                    @foreach (var m in team.Members)
                    {
                        var key = $"{team.ParticipantId}:{m.Id}";
                        var pending = _pending.GetValueOrDefault(key, 0);
                        <div class="row" style="margin-top:.4rem">
                            <span class="grow">@m.Name</span>
                            @StepperFor(key, pending)
                            <button class="btn small success" @onclick="() => RecordAsync(team.ParticipantId, m.Id, key)" disabled="@(_busy || pending == 0)">Add</button>
                        </div>
                    }
                </div>
            }
            else
            {
                var key = $"{team.ParticipantId}";
                var pending = _pending.GetValueOrDefault(key, 0);
                <div class="row" style="border-bottom:1px solid var(--line);padding:.5rem 0">
                    <span class="grow"><b>@team.Name</b></span>
                    @StepperFor(key, pending)
                    <button class="btn small success" @onclick="() => RecordAsync(team.ParticipantId, null, key)" disabled="@(_busy || pending == 0)">Add</button>
                </div>
            }
        }
    }
    else if (Participants.Count == 0)
    {
        <p class="muted">No players have joined yet.</p>
    }
    else
    {
        @* Standalone activity — individual players *@
        @foreach (var p in Participants)
        {
            var key = $"{p.Id}";
            var pending = _pending.GetValueOrDefault(key, 0);
            <div class="row" style="border-bottom:1px solid var(--line);padding:.5rem 0">
                <span class="grow"><b>@p.DisplayName</b></span>
                @StepperFor(key, pending)
                <button class="btn small success" @onclick="() => RecordAsync(p.Id, null, key)" disabled="@(_busy || pending == 0)">Add</button>
            </div>
        }
    }
</div>

<div class="card">
    <h2>History</h2>
    @if (_history.Count == 0)
    {
        <p class="muted">No scores recorded yet.</p>
    }
    else
    {
        <ul class="list">
            @foreach (var s in _history.OrderByDescending(s => s.Id))
            {
                <li>
                    <span class="badge">R@(s.Round)</span>
                    <span class="grow">@(s.UserName ?? s.ParticipantName)</span>
                    <b style="font-variant-numeric:tabular-nums">@(IsPoints ? (s.Points >= 0 ? "+" : "") + Fmt.Num(s.Points) : Format(s.Points))</b>
                    @if (CanManage)
                    {
                        <button class="btn ghost small danger" @onclick="() => DeleteAsync(s.Id)" disabled="@_busy">✕</button>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public ActivityDto Activity { get; set; } = default!;
    [Parameter] public PlayerSession Session { get; set; } = default!;
    [Parameter] public List<ParticipantDto> Participants { get; set; } = new();
    [Parameter] public int RefreshKey { get; set; }

    // Per-event management (deleting a score): the server-computed Activity.CanManage.
    private bool CanManage => !State.PreviewAsPlayer && (State.HasAdminCode || Activity.CanManage);

    /// <summary>The activity's live connection — used to broadcast/receive the running stopwatch so
    /// everyone watching sees the time-counter tick, not just the scorekeeper running it.</summary>
    [Parameter] public ScoreboardConnection? Connection { get; set; }

    private int _round = 1;
    private readonly Dictionary<string, double> _pending = new();
    private List<ScoreEntryDto> _history = new();
    private List<TeamDto> _teams = new();
    private bool _busy;
    private string? _error;
    private int _lastRefreshKey = -1;
    private int _loadedActivityId = -1;

    private readonly Dictionary<string, DateTimeOffset> _swStart = new();

    // Stopwatches other scorekeepers are running, relayed live so we can tick them too (key → start).
    private readonly Dictionary<string, DateTimeOffset> _remoteStart = new();
    private ScoreboardConnection? _subscribedConn;

    private bool RemoteRunning(string key) => !IsRunning(key) && _remoteStart.ContainsKey(key);
    private double RemoteElapsed(string key) =>
        _remoteStart.TryGetValue(key, out var start) ? (DateTimeOffset.UtcNow - start).TotalSeconds : 0;

    private bool PerPlayer => Activity.ScoreEntryMode == ScoreEntryMode.PerPlayer;
    private bool IsPoints => Activity.Measurement == Measurement.Points;

    // The round count for the team format. Never fewer than what's already been recorded, so an
    // existing multi-round game (or one whose count was lowered) isn't truncated mid-play.
    private int HistoryMaxRound => _history.Count > 0 ? _history.Max(s => s.Round) : 1;
    private int MaxRound => PerPlayer ? 1 : Math.Max(Math.Max(1, Activity.RoundCount), HistoryMaxRound);

    // A one-line summary of the configured structure + how much is recorded (team events only,
    // where the expected number of scores is well-defined).
    private string? StructureNote()
    {
        if (Activity.Type != ActivityType.ScoreGame)
        {
            return null;
        }

        var parts = new List<string>
        {
            PerPlayer ? "Each player plays one round" : $"{MaxRound} round{(MaxRound == 1 ? "" : "s")}",
        };
        if (Activity.PlayersPerRound is int p)
        {
            parts.Add($"{p} player{(p == 1 ? "" : "s")} per round");
        }

        if (Progress() is { } prog)
        {
            parts.Add(prog);
        }

        return string.Join(" · ", parts);
    }

    private string? Progress()
    {
        if (_teams.Count == 0)
        {
            return null; // standalone / not yet formed — no fixed expected count
        }

        if (PerPlayer)
        {
            var total = _teams.Sum(t => t.Members.Count);
            if (total == 0) return null;
            var done = _history.Where(s => s.UserId is not null)
                .Select(s => (s.ParticipantId, s.UserId)).Distinct().Count();
            return $"{done}/{total} players recorded";
        }

        var slots = _teams.Count * MaxRound;
        if (slots == 0) return null;
        var filled = _history.Where(s => s.Round >= 1 && s.Round <= MaxRound)
            .Select(s => (s.ParticipantId, s.Round)).Distinct().Count();
        return $"{filled}/{slots} rounds recorded";
    }
    private string UnitSuffix => Activity.MeasuresTime ? "s" : Activity.MeasuresLength ? "mm" : string.Empty;

    private List<(int Id, string Name)> Units() => _teams.Count > 0
        ? _teams.Select(t => (t.ParticipantId, t.Name)).ToList()
        : Participants.Select(p => (p.Id, p.DisplayName)).ToList();

    private double UnitValue(int id) => _history.Where(s => s.ParticipantId == id).Sum(s => s.Points);
    private int UnitCount(int id) => _history.Count(s => s.ParticipantId == id);

    private string Format(double value) => Activity.Measurement switch
    {
        Measurement.TimeSeconds => $"{Fmt.Num(value)} s",
        Measurement.Millimetres => $"{Fmt.Num(value)} mm",
        _ => Fmt.Num(value),
    };

    private bool IsRunning(string key) => _swStart.ContainsKey(key);

    private double Elapsed(string key) => _swStart.TryGetValue(key, out var start)
        ? (DateTimeOffset.UtcNow - start).TotalSeconds
        : 0;

    private static string Clock(double seconds)
    {
        var s = (int)Math.Round(seconds);
        return $"{s / 60}:{s % 60:00}";
    }

    private System.Threading.Timer? _ticker;

    // While any stopwatch is running, re-render a few times a second so the live time ticks up.
    private void EnsureTicking() =>
        _ticker ??= new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            if (_swStart.Count == 0 && _remoteStart.Count == 0)
            {
                _ticker?.Dispose();
                _ticker = null;
                return;
            }

            StateHasChanged();
        }), null, 250, 250);

    public void Dispose()
    {
        _ticker?.Dispose();
        if (_subscribedConn is not null)
        {
            _subscribedConn.TimerStarted -= OnTimerStarted;
            _subscribedConn.TimerStopped -= OnTimerStopped;
        }
    }

    // Subscribe to the live timer relay once we have a connection (and re-subscribe if it changes).
    private void EnsureTimerSubscription()
    {
        if (ReferenceEquals(_subscribedConn, Connection))
        {
            return;
        }

        if (_subscribedConn is not null)
        {
            _subscribedConn.TimerStarted -= OnTimerStarted;
            _subscribedConn.TimerStopped -= OnTimerStopped;
        }

        _subscribedConn = Connection;
        if (_subscribedConn is not null)
        {
            _subscribedConn.TimerStarted += OnTimerStarted;
            _subscribedConn.TimerStopped += OnTimerStopped;
        }
    }

    private void OnTimerStarted(TimerStateDto t) => _ = InvokeAsync(() =>
    {
        if (t.ActivityId != Activity.Id) return;
        _remoteStart[t.Key] = t.StartedUtc;
        EnsureTicking();
        StateHasChanged();
    });

    private void OnTimerStopped(TimerStateDto t) => _ = InvokeAsync(() =>
    {
        if (t.ActivityId != Activity.Id) return;
        _remoteStart.Remove(t.Key);
        StateHasChanged();
    });

    private void ToggleStopwatch(string key)
    {
        if (_swStart.TryGetValue(key, out var start))
        {
            _pending[key] = Math.Clamp(Math.Round((DateTimeOffset.UtcNow - start).TotalSeconds), 0d, 100000d);
            _swStart.Remove(key);
            _ = Connection?.StopTimerAsync(Activity.Id, key); // tell viewers it stopped
        }
        else
        {
            _swStart[key] = DateTimeOffset.UtcNow;
            EnsureTicking();
            _ = Connection?.StartTimerAsync(Activity.Id, key); // let viewers tick along
        }
    }

    private void SetPending(string key, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _pending[key] = Math.Clamp(v, 0d, 100000d);
        }
    }

    private async Task RecordSingleAsync(int participantId, string key)
    {
        var value = _pending.GetValueOrDefault(key, 0);
        if (value <= 0)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Api.RecordScoreAsync(Activity.Id, new RecordScoreRequest
            {
                ParticipantId = participantId,
                Round = 1,
                Points = value,
            }, Session.Token);

            _pending[key] = 0;
            _swStart.Remove(key);
            await LoadHistoryAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private RenderFragment StepperFor(string key, double pending) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "stepper");
        builder.AddAttribute(2, "style", "width:auto");

        builder.OpenElement(3, "button");
        builder.AddAttribute(4, "disabled", pending <= 0);
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => Adjust(key, -1)));
        builder.AddContent(6, "−");
        builder.CloseElement();

        builder.OpenElement(7, "span");
        builder.AddAttribute(8, "class", "value");
        builder.AddAttribute(9, "style", "min-width:2ch;font-size:1.3rem");
        builder.AddContent(10, Fmt.Num(pending));
        builder.CloseElement();

        builder.OpenElement(11, "button");
        builder.AddAttribute(12, "onclick", EventCallback.Factory.Create(this, () => Adjust(key, 1)));
        builder.AddContent(13, "+");
        builder.CloseElement();

        builder.CloseElement();
    };

    protected override async Task OnParametersSetAsync()
    {
        EnsureTimerSubscription();

        if (Activity.Id != _loadedActivityId)
        {
            _loadedActivityId = Activity.Id;
            _pending.Clear();
            _swStart.Clear();
            _round = 1;
            _lastRefreshKey = RefreshKey;
            await LoadAsync();
            return;
        }

        if (RefreshKey != _lastRefreshKey)
        {
            _lastRefreshKey = RefreshKey;
            await LoadHistoryAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (Activity.EventId is not null)
        {
            try { _teams = await Api.GetTeamsAsync(Activity.Id); } catch (ApiException) { _teams = new(); }
        }

        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            _history = await Api.GetScoresAsync(Activity.Id);
            if (_history.Count > 0)
            {
                _round = Math.Max(_round, _history.Max(s => s.Round));
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void SetRound(int value) => _round = Math.Clamp(value, 1, MaxRound);

    private void Adjust(string key, int delta)
        => _pending[key] = Math.Clamp(_pending.GetValueOrDefault(key, 0) + delta, 0d, 99d);

    private async Task RecordAsync(int participantId, int? userId, string key)
    {
        var points = _pending.GetValueOrDefault(key, 0);
        if (points == 0)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Api.RecordScoreAsync(Activity.Id, new RecordScoreRequest
            {
                ParticipantId = participantId,
                UserId = userId,
                Round = PerPlayer ? 1 : _round, // per-player format is one score per player, no rounds
                Points = points,
            }, Session.Token);

            _pending[key] = 0;
            await LoadHistoryAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int scoreId)
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DeleteScoreAsync(Activity.Id, scoreId);
            await LoadHistoryAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
