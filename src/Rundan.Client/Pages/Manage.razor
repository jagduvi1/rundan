@page "/manage/{Id:int}"
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Manage · Rundan</PageTitle>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else if (_activity is null)
{
    <div class="card">
        <h1>Not found</h1>
        <p class="muted">@(_error ?? "That activity doesn't exist.")</p>
        <a class="btn" href="admin">Back to host panel</a>
    </div>
}
else
{
    <div class="card stack">
        <div class="row">
            <h1 class="grow">@_activity.Title</h1>
            <StatusBadge Status="_activity.Status" />
        </div>
        <div class="muted">@Fmt.TypeLabel(_activity.Type) · @CountSummary()</div>

        <div class="row wrap" style="align-items:center">
            <span class="join-code">@_activity.JoinCode</span>
            <button class="btn ghost small" @onclick="CopyCodeAsync">@(_copied ? "Copied ✓" : "Copy code")</button>
            <a class="btn ghost small" href="@($"a/{_activity.Id}")">Open player view</a>
        </div>

        @if (_error is not null)
        {
            <div class="alert error">@_error</div>
        }

        <div class="row wrap">
            @foreach (var (label, status, cls) in NextActions())
            {
                <button class="btn @cls" @onclick="() => SetStatusAsync(status)" disabled="@_busy">@label</button>
            }
        </div>

        <div class="row">
            @if (!_confirmDelete)
            {
                <button class="btn ghost small danger" @onclick="() => _confirmDelete = true">Delete activity</button>
            }
            else
            {
                <span class="muted grow">Delete for good?</span>
                <button class="btn danger small" @onclick="DeleteAsync" disabled="@_busy">Yes, delete</button>
                <button class="btn ghost small" @onclick="() => _confirmDelete = false">Cancel</button>
            }
        </div>
    </div>

    <div class="card stack">
        <h2>Details</h2>
        <div class="field">
            <label>Title</label>
            <input @bind="_editTitle" maxlength="200" />
        </div>
        <div class="field">
            <label>Rules / info</label>
            <RichTextEditor @key="_activity.Id" Value="@_editDescription" ValueChanged="v => _editDescription = v"
                            Placeholder="Explain how this game works — use the toolbar for bullet lists" />
        </div>
        <div class="field">
            <label>How players will see the rules (auto, from the type &amp; scoring)</label>
            <ul class="muted" style="margin:.1rem 0 0;padding-left:1.15rem;line-height:1.55;font-size:.9rem">
                @foreach (var line in Fmt.RulesSummary(_activity))
                {
                    <li>@line</li>
                }
            </ul>
        </div>
        <div class="field">
            <label>Picture / map</label>
            <ImageUploader Value="@_editImage" ValueChanged="v => _editImage = v" />
        </div>

        <div class="field">
            <label class="row" style="font-weight:500">
                <input type="checkbox" style="width:auto;min-height:auto"
                       checked="@_editPublic" @onchange="e => _editPublic = (bool)e.Value!" />
                <span>Add to the library (reusable in other events)</span>
            </label>
        </div>

        @if (_activity.UsesQuestions)
        {
            <div class="field">
                <label class="row" style="font-weight:500">
                    <input type="checkbox" style="width:auto;min-height:auto"
                           checked="@_editRandomize" @onchange="e => _editRandomize = (bool)e.Value!" />
                    <span>Randomize question order per player</span>
                </label>
            </div>
            <div class="field">
                <label class="row" style="font-weight:500">
                    <input type="checkbox" style="width:auto;min-height:auto"
                           checked="@_editHideQuestions" @onchange="e => _editHideQuestions = (bool)e.Value!" />
                    <span>Hide questions from me — I'm playing too</span>
                </label>
                <p class="muted" style="font-size:.8rem;margin-top:-.3rem">
                    Blanks the questions here (e.g. ones pulled from the library) so you don't spoil them. Players still see them.
                </p>
            </div>
        }

        @if (_activity.UsesRounds)
        {
            <div class="field">
                <label>What you record</label>
                <select @bind="_editMeasurement">
                    <option value="@Measurement.Points">Points / count</option>
                    <option value="@Measurement.TimeSeconds">Time (mm:ss)</option>
                    <option value="@Measurement.Millimetres">Length (millimetres)</option>
                </select>
            </div>
            <div class="field">
                <label>Who wins</label>
                <select @bind="_editScoringMode">
                    <option value="@ScoringMode.HigherWins">Highest wins</option>
                    <option value="@ScoringMode.LowerWins">Lowest wins (e.g. fastest time)</option>
                    <option value="@ScoringMode.ClosestToTarget">Closest to a target wins</option>
                </select>
            </div>
            @if (_editScoringMode == ScoringMode.ClosestToTarget)
            {
                <div class="field">
                    <label>Target @(_editMeasurement == Measurement.TimeSeconds ? "(seconds — 147 = 2:27)" : "value")</label>
                    <input type="number" min="0" max="100000" @bind="_editTarget" style="width:160px" />
                </div>
            }
            <div class="field">
                <label>Score entry</label>
                <select @bind="_editScoreEntryMode">
                    <option value="@ScoreEntryMode.Team">One score per team, per round</option>
                    <option value="@ScoreEntryMode.PerPlayer">Per player, per round (summed to the team)</option>
                </select>
            </div>
        }

        @if (_activity.Type == ActivityType.Boule)
        {
            <div class="field">
                <label>Match results (how a bracket result is entered)</label>
                <select @bind="_editMatchFormat">
                    <option value="@MatchFormat.Free">Free scoring — one score per match, higher wins</option>
                    <option value="@MatchFormat.Sets">Sets — best-of, take the most sets</option>
                </select>
            </div>
            @if (_editMatchFormat == MatchFormat.Sets)
            {
                <div class="row wrap">
                    <div class="field" style="width:170px">
                        <label>Sets per match</label>
                        <select @bind="_editBestOfSets">
                            <option value="1">Single set</option>
                            <option value="3">Best of 3</option>
                            <option value="5">Best of 5</option>
                        </select>
                    </div>
                    <div class="field" style="width:170px">
                        <label>Games to win a set</label>
                        <input type="number" min="1" max="100" @bind="_editGames" />
                    </div>
                </div>
            }
        }

        @if (!_activity.UsesMap)
        {
            <div class="field">
                <label>Location geofence (optional)</label>
                <p class="muted" style="font-size:.85rem">Set a GPS point + radius. The activity unlocks on a player's phone when they enter the radius.</p>
                <LocationPicker @key="_activity.Id" Lat="_editLat" Lng="_editLng" Radius="_editRadius" Changed="OnLocationChanged" />
            </div>
        }

        <button class="btn block success" @onclick="SaveDetailsAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_editTitle))">
            Save details
        </button>
    </div>

    <div class="card stack">
        <h2>Courts / lanes</h2>
        <p class="muted" style="font-size:.85rem">Add the playing surfaces (courts, fields, tracks, lanes). For Boule they're used to schedule the order of play.</p>
        <div class="field">
            <label>What they're called</label>
            <input @bind="_editCourtLabel" maxlength="30" placeholder="Court" style="width:180px" />
        </div>
        @for (var i = 0; i < _editCourtNames.Count; i++)
        {
            var idx = i;
            <div class="row">
                <input class="grow" @bind="_editCourtNames[idx]" maxlength="60" />
                <button class="btn ghost small danger" @onclick="() => RemoveCourt(idx)">✕</button>
            </div>
        }
        <div class="row">
            <button class="btn ghost small" @onclick="AddCourt">+ Add @((_editCourtLabel ?? "Court").Trim().ToLower())</button>
            <span class="grow"></span>
            <button class="btn success small" @onclick="SaveCourtsAsync" disabled="@_busy">Save courts</button>
        </div>
    </div>

    @if (_activity.UsesQuestions)
    {
        @if (_activity.Status == ActivityStatus.Draft)
        {
            @if (_activity.UsesMap)
            {
                @* Distinct keys: these two render as siblings for a tipspromenad, so they can't share a key. *@
                <StationsEditor Activity="_activity" @key="(1, _activity.Id)" RefreshKey="_qVersion" OnChanged="BumpQuestions" />
            }
            <QuestionEditor Activity="_activity" @key="(2, _activity.Id)" RefreshKey="_qVersion" OnChanged="BumpQuestions" />
        }
        else
        {
            <div class="card muted">
                Questions are locked while the activity is @_activity.Status.
                Set it back to <b>Draft</b> to edit them.
            </div>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ActivityDto? _activity;
    private bool _loading = true;
    private bool _busy;
    private bool _confirmDelete;
    private bool _copied;
    private string? _error;

    private string _editTitle = string.Empty;
    private string? _editDescription;
    private string? _editImage;
    private ScoreEntryMode _editScoreEntryMode = ScoreEntryMode.Team;
    private ScoringMode _editScoringMode = ScoringMode.HigherWins;
    private Measurement _editMeasurement = Measurement.Points;
    private int _editTarget = 147;
    private MatchFormat _editMatchFormat = MatchFormat.Free;
    private int _editBestOfSets = 3;
    private int _editGames = 13;
    private bool _editRandomize;
    private bool _editHideQuestions;
    private bool _editPublic;
    private string _editCourtLabel = "Court";
    private List<string> _editCourtNames = new();
    private double? _editLat;
    private double? _editLng;
    private int _editRadius = 25;
    private int _loadedId = -1;

    // Bumped to keep the Stations panel and the Questions editor in sync (each reloads on change).
    private int _qVersion;

    protected override async Task OnParametersSetAsync()
    {
        // Reload when the route id changes (Blazor reuses this component instance across /manage/{id}).
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await State.EnsureInitializedAsync(Api);
        _activity = await Api.GetActivityAsync(Id);
        if (_activity is not null)
        {
            _editTitle = _activity.Title;
            _editDescription = _activity.Description;
            _editImage = _activity.ImageUrl;
            _editScoreEntryMode = _activity.ScoreEntryMode;
            _editScoringMode = _activity.ScoringMode;
            _editMeasurement = _activity.Measurement;
            _editTarget = _activity.TargetValue ?? 147;
            _editMatchFormat = _activity.MatchFormat;
            _editBestOfSets = _activity.BestOfSets is 1 or 3 or 5 ? _activity.BestOfSets : 3;
            _editGames = _activity.GamesToWinSet;
            _editRandomize = _activity.RandomizeQuestions;
            _editHideQuestions = _activity.HideQuestionsFromHost;
            _editPublic = _activity.IsPublic;
            _editCourtLabel = _activity.CourtLabel;
            _editCourtNames = _activity.Courts.Select(c => c.Name).ToList();
            _editLat = _activity.Latitude;
            _editLng = _activity.Longitude;
            _editRadius = _activity.RadiusMeters ?? 25;

            // Carry the event-admin token so a co-host can manage this activity.
            if (_activity.EventId is { } evId)
            {
                var memberToken = await State.GetEventMemberTokenAsync(evId);
                if (memberToken is not null)
                {
                    State.ActiveMemberToken = memberToken;
                }
            }
        }

        _loading = false;
    }

    private void AddCourt() => _editCourtNames.Add($"{(_editCourtLabel ?? "Court").Trim()} {_editCourtNames.Count + 1}");

    private void RemoveCourt(int index)
    {
        if (index >= 0 && index < _editCourtNames.Count)
        {
            _editCourtNames.RemoveAt(index);
        }
    }

    private async Task SaveCourtsAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _activity = await Api.SetCourtsAsync(Id, (_editCourtLabel ?? "Court").Trim(), _editCourtNames);
            _editCourtLabel = _activity.CourtLabel;
            _editCourtNames = _activity.Courts.Select(c => c.Name).ToList();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // "4 teams · 8 players" for a team event activity, otherwise just the player count.
    private string CountSummary()
    {
        if (_activity is null)
        {
            return string.Empty;
        }

        var players = $"{_activity.PlayerCount} player{(_activity.PlayerCount == 1 ? "" : "s")}";
        return _activity.IsTeamBased
            ? $"{_activity.TeamCount} team{(_activity.TeamCount == 1 ? "" : "s")} · {players}"
            : players;
    }

    private void OnLocationChanged((double? Lat, double? Lng, int Radius) loc)
    {
        _editLat = loc.Lat;
        _editLng = loc.Lng;
        _editRadius = loc.Radius;
    }

    // One editor changed the question set — nudge both to reload so the count + statuses stay in sync.
    private void BumpQuestions() => _qVersion++;

    private async Task SaveDetailsAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _activity = await Api.UpdateActivityAsync(Id, new UpdateActivityRequest
            {
                Title = _editTitle.Trim(),
                Description = _editDescription,
                ImageUrl = _editImage,
                ScoringMode = _editScoringMode,
                Measurement = _editMeasurement,
                TargetValue = _editTarget,
                RandomizeQuestions = _editRandomize,
                HideQuestionsFromHost = _editHideQuestions,
                IsPublic = _editPublic,
                ScoreEntryMode = _editScoreEntryMode,
                Latitude = _editLat,
                Longitude = _editLng,
                RadiusMeters = _editLat.HasValue ? _editRadius : null,
                MatchFormat = _editMatchFormat,
                BestOfSets = _editBestOfSets,
                GamesToWinSet = _editGames,
            });

            // Reload the question/stations grids so the "hide questions" toggle masks (or reveals) right away.
            BumpQuestions();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<(string Label, ActivityStatus Status, string Css)> NextActions()
    {
        if (_activity is null)
        {
            yield break;
        }

        switch (_activity.Status)
        {
            case ActivityStatus.Draft:
                yield return ("Open lobby", ActivityStatus.Open, "success");
                break;
            case ActivityStatus.Open:
                yield return ("Start", ActivityStatus.Live, "success");
                yield return ("Back to draft", ActivityStatus.Draft, "secondary");
                break;
            case ActivityStatus.Live:
                yield return ("Finish", ActivityStatus.Finished, "");
                break;
            case ActivityStatus.Finished:
                yield return ("Re-open", ActivityStatus.Live, "secondary");
                yield return ("Back to lobby", ActivityStatus.Open, "secondary");
                break;
        }
    }

    private async Task SetStatusAsync(ActivityStatus status)
    {
        _busy = true;
        _error = null;
        try
        {
            _activity = await Api.SetStatusAsync(Id, status);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.DeleteActivityAsync(Id);
            Nav.NavigateTo("admin");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private async Task CopyCodeAsync()
    {
        if (_activity is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _activity.JoinCode);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false; // restore the affordance so it can be used again
        }
        catch
        {
            /* clipboard not available — the code is visible anyway */
        }
    }
}
