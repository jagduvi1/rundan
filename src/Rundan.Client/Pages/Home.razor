@page "/"
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Rundan</PageTitle>

<div class="card hero stack center">
    <img src="img/rundan-mark.svg" width="64" height="64" alt="" style="margin:0 auto" />
    <h1>Welcome to Rundan</h1>
    <p style="color:rgba(255,255,255,.9)">A day out with your people — quiz walks, games and a friendly scoreboard.</p>
</div>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else
{
    @if (_events.Count == 0)
    {
        <div class="card stack">
            <h2>Nothing scheduled just yet</h2>
            <p class="muted">When your host sets up a day, it'll show up right here. Got a code? Use it below.</p>
        </div>
    }
    else
    {
        @if (_events.Count > 1)
        {
            <h2 style="margin:.25rem 0 -.25rem">What's on</h2>
        }
        @foreach (var ev in _events)
        {
            @EventCard(ev)
        }
    }
}

<div class="card stack">
    <h2>Got a code?</h2>
    <p class="muted">Type the code your host shared to jump straight in.</p>

    @if (_error is not null)
    {
        <div class="alert error">@_error</div>
    }

    <input class="code-input" type="text" inputmode="text" autocomplete="off" maxlength="16"
           placeholder="CODE" @bind="_code" @bind:event="oninput" @onkeydown="OnKeyDown" />

    <button class="btn block" @onclick="GoAsync" disabled="@_busy">
        @(_busy ? "Looking…" : "Let's go")
    </button>
</div>

<div class="card center muted">
    Hosting today? <a href="admin">Open the host panel</a>
</div>

@code {
    private List<EventDto> _events = new();
    private readonly Dictionary<int, string> _names = new();
    private readonly Dictionary<int, string> _winners = new();
    private bool _loading = true;

    private string _code = string.Empty;
    private string? _error;
    private bool _busy;

    private RenderFragment EventCard(EventDto ev) =>
    @<div class="card stack">
        @if (!string.IsNullOrEmpty(ev.ImageUrl))
        {
            <img src="@ev.ImageUrl" alt="" style="width:100%;border-radius:var(--radius-md)" />
        }
        <h2>@ev.Name</h2>
        @if (ev.IsComplete)
        {
            <div class="row" style="gap:.5rem;align-items:center">
                <span class="final-badge">Completed</span>
                @if (_winners.TryGetValue(ev.Id, out var win))
                {
                    <span><b>Winner: @win</b></span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ev.Description))
        {
            <p class="muted" style="white-space:pre-wrap">@ev.Description</p>
        }
        <div class="row wrap muted" style="font-size:.85rem;gap:.5rem">
            <span>@ev.Activities.Count activit@(ev.Activities.Count == 1 ? "y" : "ies")</span>
            <span>·</span>
            <span>teams of @ev.TeamSize</span>
            <span>·</span>
            <span>@(ev.Scoring == EventScoring.Placement ? "placement scoring" : "points scoring")</span>
            @if (ev.EstimatedMeters is { } m)
            {
                <span>·</span>
                <span>≈ @FormatDistance(m) on foot</span>
            }
        </div>

        @if (ev.Activities.Count > 0)
        {
            <ul class="list">
                @foreach (var a in ev.Activities.OrderBy(a => a.Order))
                {
                    <li>
                        <span class="grow">
                            <b>@a.Order.</b> @a.Title
                            <span class="muted" style="font-size:.8rem"> · @TypeLabel(a.Type)</span>
                        </span>
                        <StatusBadge Status="a.Status" />
                    </li>
                }
            </ul>
        }

        <button class="btn block success" @onclick="() => Enter(ev.Id)">
            @(ev.IsComplete
                ? "See final results"
                : _names.TryGetValue(ev.Id, out var name) ? $"Continue as {name}" : $"Enter {ev.Name}")
        </button>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureInitializedAsync(Api);
        try
        {
            _events = await Api.GetActiveEventsAsync();
            foreach (var ev in _events)
            {
                var saved = await State.GetEventNameAsync(ev.Id);
                if (saved is not null)
                {
                    _names[ev.Id] = saved;
                }

                if (ev.IsComplete)
                {
                    var standings = await Api.GetEventStandingsAsync(ev.Id);
                    var winners = standings?.Entries.Where(e => e.Rank == 1).Select(e => e.DisplayName).ToList();
                    if (winners is { Count: > 0 })
                    {
                        _winners[ev.Id] = string.Join(" & ", winners);
                    }
                }
            }
        }
        catch (ApiException)
        {
            // Leave the welcome page on the code-entry fallback if the list can't load.
        }
        finally
        {
            _loading = false;
        }
    }

    private void Enter(int eventId) => Nav.NavigateTo($"e/{eventId}");

    private static string FormatDistance(int meters) =>
        meters >= 1000 ? $"{meters / 1000.0:0.0} km" : $"{meters} m";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GoAsync();
        }
    }

    private async Task GoAsync()
    {
        var code = _code.Trim().ToUpperInvariant();
        if (code.Length == 0)
        {
            _error = "Enter a code first.";
            return;
        }

        _busy = true;
        _error = null;

        // A code can be an event (a whole day of activities) or a single activity.
        var ev = await Api.GetEventByCodeAsync(code);
        if (ev is not null)
        {
            _busy = false;
            Nav.NavigateTo($"e/{ev.Id}");
            return;
        }

        var activity = await Api.GetActivityByCodeAsync(code);
        _busy = false;

        if (activity is null)
        {
            _error = "No event or activity found with that code.";
            return;
        }

        Nav.NavigateTo($"a/{activity.Id}");
    }

    private static string TypeLabel(ActivityType type) => type switch
    {
        ActivityType.Quiz => "Quiz",
        ActivityType.Tipspromenad => "Tipspromenad",
        ActivityType.Boule => "Boule",
        ActivityType.ScoreGame => "Score game",
        ActivityType.WordGame => "Word game",
        _ => type.ToString(),
    };
}
