@page "/"
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Rundan</PageTitle>

@if (_loading)
{
    @* Past the access gate we send people straight to their event, so this is just a brief beat. *@
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else
{
    @* Only reached when there's nothing to jump to. *@
    <WelcomeHero />
    <div class="card stack">
        <h2>Nothing scheduled just yet</h2>
        <p class="muted">When your host sets up a day, it'll show up right here. Got a code? Open the menu (top-left ☰) to jump in.</p>
    </div>
}

@code {
    private bool _loading = true;

    // The landing page is a router: once a returning visitor is past the access gate we send them
    // straight to their event (the one they last opened, or the single one still in play). The full
    // list lives on /events, reached from the header menu and the logo. We only render the
    // welcome/empty state when there's genuinely nowhere to send them — or a load failed.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await State.EnsureInitializedAsync(Api);
            var events = await Api.GetActiveEventsAsync();

            if (await PickLandingEventAsync(events) is { } eventId)
            {
                Nav.NavigateTo($"e/{eventId}", replace: true);
                return;
            }

            if (events.Count > 1)
            {
                // Several to choose from and no clear one — let them pick from the list.
                Nav.NavigateTo("events", replace: true);
                return;
            }
        }
        catch (Exception)
        {
            // Network / parse failure — fall through to the welcome/empty state rather than hang on
            // the spinner. (ApiException only covers HTTP error codes, not transport drops, which
            // are exactly what flaky mobile signal throws.)
        }

        _loading = false; // zero events, or a load failure → show the welcome state
    }

    // The event to drop a returning visitor on: the one they last opened (if it still exists),
    // otherwise the single event that's still open to play. Null means "can't decide — don't redirect".
    private async Task<int?> PickLandingEventAsync(List<EventDto> events)
    {
        if (events.Count == 0)
        {
            return null;
        }

        var lastId = await State.GetLastEventIdAsync();
        if (lastId is { } id && events.Any(e => e.Id == id))
        {
            return id;
        }

        // No history: ignore finished past days and land on the one event still in play, if there's
        // exactly one. (If the only event there is has finished, still open it — it's all there is.)
        var inPlay = events.Where(e => !e.IsComplete).ToList();
        if (inPlay.Count == 1)
        {
            return inPlay[0].Id;
        }

        return inPlay.Count == 0 && events.Count == 1 ? events[0].Id : null;
    }
}
