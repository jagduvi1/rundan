    // Reorder: swap with the neighbour and persist the new running order.
    private async Task MoveAsync(int activityId, int delta)
    {
        if (_event is null) return;
        var ids = _event.Activities.Select(a => a.Id).ToList();
        var i = ids.IndexOf(activityId);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= ids.Count) return;
        (ids[i], ids[j]) = (ids[j], ids[i]);
        await HostActionAsync(() => Api.ReorderActivitiesAsync(Id, ids));
    }

