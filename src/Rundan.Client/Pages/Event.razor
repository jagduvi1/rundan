    private async Task StartConnectionAsync()
    {
        if (_event is null) return;
        _conn = new ScoreboardConnection(Nav, State);
        _conn.ScoreboardUpdated += OnRealtimeScore;
        _conn.StatusChanged += OnRealtimeStatus;
        _conn.ViewersChanged += OnRealtimeViewers;
        _conn.ConnectionStateChanged += OnConnectionStateChanged;
        try
        {
            await _conn.StartAsync(_event.Activities.Select(a => a.Id));
            await _conn.JoinEventAsync(Id);
        }
        catch { /* live updates unavailable */ }
    }

    private void OnRealtimeScore(ScoreboardDto _) => RefreshSoon();
    private void OnRealtimeStatus(ActivityStatusChangedDto _) => RefreshSoon();

    private void OnRealtimeViewers(EventViewersDto v) => _ = InvokeAsync(() =>
    {
        if (_event is not null && v.EventId == Id)
        {
            _event.Viewers = v.Viewers;
            StateHasChanged();
        }
    });
    private void RefreshSoon() => _ = InvokeAsync(RefreshAsync);

    private async Task RefreshAsync()
    {
        _event = await Api.GetEventAsync(Id) ?? _event;
        _standings = await Api.GetEventStandingsAsync(Id);

        if (_conn is not null && _event is not null)
        {
            foreach (var a in _event.Activities)
            {
                await _conn.EnsureJoinedAsync(a.Id);
            }
        }

        if (_event?.HasRoster == true && _userId is not null)
        {
            await ReclaimAsync();
        }
        else if (_event?.HasRoster == false && _eventName is not null)
        {
            await EnsureFreeNameSessionsAsync();
        }

        // Keep the covered player's sessions current as activities open/close.
        await RefreshProxyAsync();

        StateHasChanged();
    }

    private void OnConnectionStateChanged()
    {
        _reconnecting = _conn?.IsReconnecting ?? false;
        InvokeAsync(StateHasChanged);
    }

    // ---- Roster claim ----
    private async Task ClaimAsync(int userId)
    {
        if (_event is null) return;
        _busy = true;
        _joinError = null;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, userId);
            _userId = userId;
            _eventName = res.DisplayName;
            _isEventAdmin = res.IsEventAdmin;
            State.ActiveMemberToken = res.MemberToken;
            await State.SaveEventUserIdAsync(Id, userId);
            await State.SaveEventNameAsync(Id, res.DisplayName);
            await State.SaveEventMemberTokenAsync(Id, res.MemberToken);
            await StoreSlotsAsync(res.Slots);
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _joinError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReclaimAsync()
    {
        if (_event is null || _userId is not int uid) return;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, uid);
            _eventName = res.DisplayName;
            _isEventAdmin = res.IsEventAdmin;
            State.ActiveMemberToken = res.MemberToken;
            await State.SaveEventMemberTokenAsync(Id, res.MemberToken);
            await StoreSlotsAsync(res.Slots);
        }
        catch (ApiException) { }
    }

    private async Task StoreSlotsAsync(List<EventJoinSlotDto> slots)
    {
        foreach (var slot in slots)
        {
            _teamByActivity[slot.ActivityId] = slot.TeamName;
            await State.SaveSessionAsync(slot.ActivityId, PlayerSession.FromSlot(slot, slot.TeamName));
        }
    }

    // ---- Host: play for another player (their phone died) ----
    private async Task PlayAsAsync(int userId)
    {
        if (_event is null) return;
        _busy = true;
        _adminError = null;
        StateHasChanged(); // reflect the disabled buttons before the network round-trip
        try
        {
            // Claim the player's identity (idempotent, stable team tokens) and overlay it.
            var res = await Api.ClaimAsync(_event.JoinCode, userId);
            await State.SetProxyAsync(BuildProxy(userId, res));
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _adminError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Re-claim the proxied player so activities opened AFTER we started covering them
    // also get that player's team session (claim only returns Open/Live activities).
    // Cheap-guarded: only re-claims when some playable activity isn't covered yet, so it
    // doesn't fire a claim on every scoreboard refresh.
    private async Task RefreshProxyAsync()
    {
        if (_event is null || !ProxyHere) return;

        var missingPlayable = _event.Activities
            .Where(a => a.Status is ActivityStatus.Open or ActivityStatus.Live)
            .Any(a => !State.Proxy!.Sessions.ContainsKey(a.Id));
        if (!missingPlayable) return;

        var uid = State.Proxy!.UserId;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, uid);
            await State.SetProxyAsync(BuildProxy(uid, res));
        }
        catch (ApiException) { }
    }

    private ProxyIdentity BuildProxy(int userId, ClaimResultDto res) => new()
    {
        EventId = Id,
        UserId = userId,
        Name = res.DisplayName,
        MemberToken = res.MemberToken,
        Sessions = res.Slots.ToDictionary(s => s.ActivityId, s => PlayerSession.FromSlot(s, s.TeamName)),
    };

    private async Task StopPlayingAsAsync()
    {
        _busy = true;
        StateHasChanged();
        await State.ClearProxyAsync();
        // Force a reload so any open activity page re-reads our own (restored) session.
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    // ---- Free-name join (rosterless events) ----
    private async Task JoinFreeNameAsync()
    {
        var name = _joinName.Trim();
        if (name.Length == 0 || _event is null) return;
        _busy = true;
        _joinError = null;
        try
        {
            var result = await Api.JoinEventAsync(_event.JoinCode, name);
            await State.SaveEventNameAsync(Id, name);
            _eventName = name;
            await SaveFreeNameSlotsAsync(result, name);
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _joinError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EnsureFreeNameSessionsAsync()
    {
        if (_event is null || _eventName is null) return;
        try
        {
            var result = await Api.JoinEventAsync(_event.JoinCode, _eventName);
            await SaveFreeNameSlotsAsync(result, _eventName);
        }
        catch (ApiException) { }
    }

    // Persist a per-activity session for each joinable slot under one free-name identity.
    private async Task SaveFreeNameSlotsAsync(EventJoinResultDto result, string displayName)
    {
        foreach (var slot in result.Slots)
        {
            await State.SaveSessionAsync(slot.ActivityId, PlayerSession.FromSlot(slot, displayName));
        }
    }

