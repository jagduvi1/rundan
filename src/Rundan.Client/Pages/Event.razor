    private async Task TeardownAsync()
    {
        if (_conn is not null)
        {
            _conn.ScoreboardUpdated -= OnRealtimeScore;
            _conn.StatusChanged -= OnRealtimeStatus;
            _conn.ViewersChanged -= OnRealtimeViewers;
            _conn.ConnectionStateChanged -= OnConnectionStateChanged;
            await _conn.DisposeAsync();
            _conn = null;
        }

        if (_geo is not null)
        {
            _geo.PositionChanged -= OnGeo;
            await _geo.DisposeAsync();
            _geo = null;
        }

        _vibe = null;
        _distances.Clear();
        _arrived.Clear();
        _pos = null;
    }

    public async ValueTask DisposeAsync() => await TeardownAsync();

    private static IEnumerable<(string Label, ActivityStatus Status)> HostActions(ActivityStatus status) => status switch
    {
        ActivityStatus.Draft => new[] { ("Open lobby", ActivityStatus.Open) },
        ActivityStatus.Open => new[] { ("Start", ActivityStatus.Live) },
        ActivityStatus.Live => new[] { ("Finish", ActivityStatus.Finished) },
        ActivityStatus.Finished => new[] { ("Re-open", ActivityStatus.Live) },
        _ => Array.Empty<(string, ActivityStatus)>(),
    };

    private static string ActionLabel(ActivityStatus status) => status switch
    {
        ActivityStatus.Live => "Play now",
        ActivityStatus.Open => "Join lobby",
        ActivityStatus.Finished => "See results",
        _ => "Open",
    };

