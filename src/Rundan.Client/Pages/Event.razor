    private async Task PerformSlapAsync(PendingSlapDto slap)
    {
        if (_slapTarget == 0)
        {
            return;
        }

        _busy = true;
        _adminError = null;
        try
        {
            int? recipient = slap.EffectiveMode == SlapMode.SendToPlayer ? _slapRecipient : null;
            await Api.PerformSlapAsync(Id, slap.ActivityId, _slapTarget, recipient);
            _slapTarget = 0;
            _slapRecipient = 0;
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            _adminError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

