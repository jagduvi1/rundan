@page "/e/{Id:int}"
@implements IAsyncDisposable
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_event?.Name ?? "Event") · Rundan</PageTitle>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else if (_event is null)
{
    <div class="card">
        <h1>Not found</h1>
        <p class="muted">No event with that code or id.</p>
        <a class="btn" href="events">Back to events</a>
    </div>
}
else
{
    <div class="card stack">
        @* Once an activity is underway the event blurb collapses to a tappable bar,
           so the running order and scoreboard sit higher on the page. *@
        <div class="row">
            @if (EventUnderway)
            {
                <h1 class="grow" style="margin:0">
                    <button class="ei-toggle" @onclick="() => _eventInfoOpen = !_eventInfoOpen"
                            aria-expanded="@_eventInfoOpen" aria-controls="event-info-blurb">
                        <span class="grow">@_event.Name</span>
                        <span class="ei-chevron @(_eventInfoOpen ? "open" : null)" aria-hidden="true">⌄</span>
                    </button>
                </h1>
            }
            else
            {
                <h1 class="grow">@_event.Name</h1>
            }
            @if (_reconnecting)
            {
                <span class="badge">Reconnecting…</span>
            }
        </div>
        @if (!EventUnderway || _eventInfoOpen)
        {
            <div id="event-info-blurb" class="stack">
                @if (!string.IsNullOrEmpty(_event.ImageUrl))
                {
                    <img src="@_event.ImageUrl" alt="" class="media-img" />
                }
                @if (!string.IsNullOrWhiteSpace(_event.Description))
                {
                    <div class="rte-content">@((MarkupString)Fmt.RichHtml(_event.Description))</div>
                }
                <div class="row muted" style="font-size:.85rem">
                    <span>Event code @_event.JoinCode</span>
                    <span>·</span>
                    <span>Teams of @_event.TeamSize</span>
                    @if (ScheduleText() is { } sched)
                    {
                        <span>·</span>
                        <span>📅 @sched</span>
                    }
                </div>
            </div>
        }
        @* Availability gating stays visible even when collapsed — it's why a player can't play yet. *@
        @if (!EventOpenForMe)
        {
            <div class="alert" style="background:var(--coral-50);color:var(--coral-700);border:1px solid var(--coral-100)">
                @AvailabilityMessage()
            </div>
        }
    </div>

    @* The slap ceremony now lives inline under each finished activity in the running order below. *@

    @if (_event.IsComplete && _standings is not null && _standings.Entries.Count > 0)
    {
        <div class="card stack center final-results">
            <span class="final-badge">Final results</span>
            <h2 style="margin:.3rem 0">@WinnerLine()</h2>
            <p class="muted">@_event.Name is done — thanks for playing!</p>
            <div class="podium">
                @foreach (var e in _standings.Entries.Take(3))
                {
                    <div class="podium-spot p@(e.Rank)">
                        <div class="medal">@e.Rank</div>
                        <div class="who">@e.DisplayName</div>
                        <div class="pts">@Fmt.Num(e.TotalPoints) p</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card">
        <h2>@(_event.IsComplete ? "Final standings" : "Total standings")</h2>
        <p class="muted" style="font-size:.8rem;margin-top:-.4rem">@ScoringLabel</p>
        @if (_event.SlapMode != SlapMode.Off)
        {
            <p class="muted" style="font-size:.72rem;margin-top:-.5rem">
                Slaps: <span style="color:var(--coral-600)">−lost</span> / <span style="color:var(--green-600)">+received</span>
            </p>
        }
        @if (_standings is null || _standings.Entries.Count == 0)
        {
            <p class="muted center">No points yet — they add up across every activity.</p>
        }
        else
        {
            <div class="score-list">
                @foreach (var e in _standings.Entries)
                {
                    <div class="score-row @(IsMe(e.DisplayName) ? "me" : null) @(e.Rank == 1 ? "lead" : null)">
                        <div class="score-row__rank">@e.Rank</div>
                        <div class="score-row__name">
                            <b>@e.DisplayName @if (IsMe(e.DisplayName)) { <span class="you"> · You</span> }</b>
                            <span class="sub">@e.ActivitiesPlayed of @_event.Activities.Count activities</span>
                        </div>
                        @if (_event.SlapMode != SlapMode.Off)
                        {
                            <div style="display:flex;flex-direction:column;align-items:flex-end;font-size:.72rem;line-height:1.25;min-width:3rem" title="Slaps: lost / received">
                                <span style="color:var(--coral-600)">@(e.SlapLost > 0 ? $"−{Fmt.Num(e.SlapLost)}" : "—")</span>
                                <span style="color:var(--green-600)">@(e.SlapReceived > 0 ? $"+{Fmt.Num(e.SlapReceived)}" : "—")</span>
                            </div>
                        }
                        <div class="score-row__score">@Fmt.Num(e.TotalPoints)</div>
                    </div>
                }
            </div>
        }
    </div>

    @* ---- Identity: viewer, or claim (roster) / free-name join ---- *@
    @if (_isViewer)
    {
        <div class="card stack center">
            <span class="badge">Viewer</span>
            <p class="muted">You're watching @_event.Name as <b>@_viewerName</b> — everything updates live, but you're not competing.</p>
            <button class="btn block secondary" @onclick="StopViewingAsync" disabled="@_busy">Join as a player instead</button>
        </div>
    }
    else if (_eventName is null)
    {
        @if (_joinError is not null)
        {
            <div class="alert error">@_joinError</div>
        }

        @if (_event.HasRoster)
        {
            <div class="card stack">
                <h2>Who are you?</h2>
                <p class="muted">Tap your name to join the event.</p>
                @foreach (var m in _event.Members)
                {
                    <button class="btn block secondary" @onclick="() => ClaimAsync(m.Id)" disabled="@_busy">@m.Name</button>
                }
            </div>
        }
        else
        {
            <div class="card stack">
                <h2>Join “@_event.Name”</h2>
                <p class="muted">Pick a name — you'll use it for every activity.</p>
                <input type="text" maxlength="60" placeholder="Your name" @bind="_joinName" @bind:event="oninput" />
                <button class="btn block" @onclick="JoinFreeNameAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_joinName))">
                    Join the event
                </button>
            </div>
        }

        <div class="card stack">
            <h3>Just watching?</h3>
            <p class="muted">Spectate everything live without competing.</p>
            <input type="text" maxlength="60" placeholder="Your name" @bind="_viewerName" @bind:event="oninput" />
            <button class="btn ghost block" @onclick="WatchAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_viewerName))">
                Watch as viewer
            </button>
        </div>
    }
    else
    {
        <div class="card center muted">You're playing as <b>@_eventName</b>.</div>
    }

    @if (_event.Viewers.Count > 0)
    {
        <div class="card">
            <h3>Watching now (@_event.Viewers.Count)</h3>
            <p class="muted">@string.Join(", ", _event.Viewers)</p>
        </div>
    }

    <div class="card">
        <h2>Activities</h2>
        @if (_event.Activities.Count == 0)
        {
            <p class="muted">No activities yet@(CanManage ? " — add the first one below." : ".")</p>
        }
        else
        {
            <ul class="list">
                @foreach (var a in _event.Activities)
                {
                    <li style="flex-direction:column;align-items:stretch;gap:.55rem">
                        @* Title + type + your team — full width. *@
                        <div>
                            <b>@a.Order. @a.Title</b>
                            <div class="muted" style="font-size:.85rem">@Fmt.TypeLabel(a.Type)</div>
                            @{
                                var ownTeam = _teamByActivity.TryGetValue(a.Id, out var ot) && !string.IsNullOrEmpty(ot) ? ot : null;
                                var proxyTeam = ProxyTeam(a.Id);
                            }
                            @if (proxyTeam is not null)
                            {
                                @* Playing as someone else: show their team (primary) and your own (secondary). *@
                                <div style="font-size:.8rem;color:var(--sea-600)">@State.Proxy!.Name's team: @proxyTeam</div>
                                @if (ownTeam is not null)
                                {
                                    <div style="font-size:.75rem;color:var(--sea-400)">Your own team: @ownTeam</div>
                                }
                            }
                            else if (ownTeam is not null)
                            {
                                <div style="font-size:.8rem;color:var(--sea-600)">Your team: @ownTeam</div>
                            }
                        </div>

                        @* Activity picture, if one is set. *@
                        @if (!string.IsNullOrEmpty(a.ImageUrl))
                        {
                            <img src="@a.ImageUrl" alt="" class="media-img" />
                        }

                        @* Status + the action — join/play only while the event window is open (host always passes). *@
                        <div class="row wrap">
                            <StatusBadge Status="a.Status" />
                            @if (IsLocked(a) && EventOpenForMe)
                            {
                                @* The geofence is a nudge, not a hard lock — let players in even if they're not at the spot. *@
                                <a class="btn ghost small" href="@($"a/{a.Id}")">Join anyway</a>
                            }
                            else if (a.Status == ActivityStatus.Finished || (EventOpenForMe && a.Status is ActivityStatus.Live or ActivityStatus.Open))
                            {
                                <a class="btn small @(a.Status == ActivityStatus.Live ? "" : "secondary")" href="@($"a/{a.Id}")">
                                    @ActionLabel(a.Status)
                                </a>
                            }
                        </div>

                        @* Map + walk-there distance for a geofenced activity, on its own row. *@
                        @if (a.HasLocation)
                        {
                            <div class="row wrap" style="font-size:.8rem;gap:.4rem">
                                <a class="btn ghost small" href="@ActivityMapsUrl(a)" target="_blank" rel="noopener" title="See where it is on a map">🗺️ Map</a>
                                @if (IsLocked(a))
                                {
                                    <span class="muted">@LockText(a)</span>
                                }
                            </div>
                        }

                        @* Slap ceremony for this finished activity: the dialog while it's open to slap,
                           a small summary once the slap (and any points pass) is done. *@
                        @if (_slapByActivity.TryGetValue(a.Id, out var slap))
                        {
                            <SlapCeremony @key="a.Id" Slap="slap" ActingUserId="ActingUserId"
                                          CanManage="@(CanManage && !ProxyHere)" OnChanged="OnInlineSlapChangedAsync" />
                        }
                    </li>
                }
            </ul>
        }
    </div>

    @* You've-arrived prompt: shown when the player walks into a ready activity's geofence. *@
    @if (_arrivedPromptId is { } arrId && _event.Activities.FirstOrDefault(x => x.Id == arrId) is { } arr)
    {
        <div class="arrival" @onclick="DismissArrival">
            @for (var c = 0; c < 14; c++)
            {
                <span class="confetti"
                      style="left:@(((c * 7 + 6) % 96))%;background:@ConfettiColor(c);border-radius:@(c % 2 == 0 ? "50%" : "3px");animation-delay:@((c % 6) * 250)ms"></span>
            }
            <div class="arrival__check">✓</div>
            <div class="arrival__title">You've arrived!</div>
            <div class="arrival__sub">@arr.Order. @arr.Title</div>
            <div class="arrival__cta">
                <button class="btn accent block" @onclick="() => GoToActivity(arrId)" @onclick:stopPropagation="true">
                    @ActionLabel(arr.Status)
                </button>
            </div>
        </div>
    }

    @if (CanManage && !ProxyHere)
    {
        <div class="card stack accent">
            <h2>Host controls</h2>
            @if (_adminError is not null)
            {
                <div class="alert error">@_adminError</div>
            }

            @* Run order — reorder, advance/pause, edit, remove *@
            @for (var i = 0; i < _event.Activities.Count; i++)
            {
                var a = _event.Activities[i];
                var index = i;
                <div style="border-bottom:1px solid var(--line);padding:.55rem 0;display:flex;flex-direction:column;gap:.45rem">
                    @* Row 1: number + title across the full width, reorder arrows right-aligned *@
                    <div class="row">
                        <span class="grow"><b>@a.Order. @a.Title</b></span>
                        <button class="btn small ghost" title="Move up" @onclick="() => MoveAsync(a.Id, -1)"
                                disabled="@(_busy || index == 0)">↑</button>
                        <button class="btn small ghost" title="Move down" @onclick="() => MoveAsync(a.Id, 1)"
                                disabled="@(_busy || index == _event.Activities.Count - 1)">↓</button>
                    </div>

                    @* Row 2: status action(s) + simulate *@
                    <div class="row wrap">
                        @foreach (var (label, status) in HostActions(a.Status))
                        {
                            <button class="btn small success" @onclick="() => SetStatusAsync(a.Id, status)"
                                    disabled="@(_busy || (status == ActivityStatus.Live && _event.PendingSlap is not null && _event.PendingSlap.ActivityId != a.Id))">
                                @label
                            </button>
                        }
                        @if (a.Status != ActivityStatus.Draft)
                        {
                            <button class="btn small ghost" title="Deactivate but keep in the event"
                                    @onclick="() => SetStatusAsync(a.Id, ActivityStatus.Draft)" disabled="@_busy">Pause</button>
                        }
                        <button class="btn small secondary" @onclick="() => SimulateActivityAsync(a.Id)" disabled="@_busy">Simulate</button>
                    </div>

                    @* Row 3: status badge + edit + remove *@
                    <div class="row wrap">
                        <StatusBadge Status="a.Status" />
                        <a class="btn small ghost" href="@($"manage/{a.Id}")">Edit</a>
                        @if (_confirmDeleteId == a.Id)
                        {
                            <button class="btn small danger" @onclick="() => RemoveActivityAsync(a.Id)" disabled="@_busy">Remove?</button>
                            <button class="btn small ghost" @onclick="() => _confirmDeleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn small ghost danger" @onclick="() => _confirmDeleteId = a.Id" disabled="@_busy">Remove</button>
                        }
                    </div>
                </div>
            }

            <h3 style="margin-top:.5rem">Add an activity — start fresh</h3>
            <input type="text" placeholder="Activity title" @bind="_newTitle" maxlength="200" />
            <select @bind="_newType">
                <option value="@ActivityType.Quiz">Quiz</option>
                <option value="@ActivityType.Tipspromenad">Tipspromenad (quiz walk)</option>
                <option value="@ActivityType.Boule">Boule (knockout)</option>
                <option value="@ActivityType.ScoreGame">Other score game</option>
                <option value="@ActivityType.WordGame">Word game</option>
                <option value="@ActivityType.MapPin">Pin the city (map)</option>
                <option value="@ActivityType.MusicQuiz">Music quiz</option>
            </select>
            <button class="btn block success" @onclick="AddActivityAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">
                Add to event
            </button>

            @if (State.IsHost && !ProxyHere)
            {
                <h3 style="margin-top:.5rem">…or add from the activity library</h3>
                @if (_library.Count == 0)
                {
                    <p class="muted" style="font-size:.85rem">No reusable activities yet. Mark any activity <b>public</b> on its Edit page (or create a standalone one) and it'll show up here to copy.</p>
                }
                else
                {
                    <p class="muted" style="font-size:.85rem">Add a copy of a public activity (rules, questions, scoring all carried over).</p>
                    <select @bind="_libSourceId">
                        <option value="0">Pick a public activity…</option>
                        @foreach (var lib in _library)
                        {
                            <option value="@lib.Id">@lib.Title</option>
                        }
                    </select>
                    <button class="btn block secondary" @onclick="AddFromLibraryAsync" disabled="@(_busy || _libSourceId <= 0)">
                        Add a copy to this event
                    </button>
                }
            }

            <h3 style="margin-top:.5rem">Restart &amp; dry run</h3>
            <p class="muted" style="font-size:.85rem">
                <b>Restart event</b> sends every activity back to Draft and clears all scores, so you can run the
                day fresh — teams and players stay in. <b>Simulate all</b> fills random results first, to check
                the scoreboards and standings before the real thing.
            </p>
            <div class="row wrap">
                <button class="btn small secondary" @onclick="SimulateEventAsync" disabled="@_busy">Simulate all</button>
                @if (!_confirmRestart)
                {
                    <button class="btn small ghost danger" @onclick="() => _confirmRestart = true" disabled="@_busy">Restart event</button>
                }
                else
                {
                    <span class="muted">Back to Draft and clear every score?</span>
                    <button class="btn small danger" @onclick="RestartEventAsync" disabled="@_busy">Yes, restart</button>
                    <button class="btn small ghost" @onclick="() => _confirmRestart = false">Cancel</button>
                }
            </div>

            <p class="muted" style="font-size:.85rem;margin-top:.5rem">
                <b>Reset all activities</b> to a status without touching scores — Draft (fresh, not opened) or Open (ready to start).
            </p>
            <div class="row wrap">
                @if (_confirmBulk is null)
                {
                    <button class="btn small ghost" @onclick="() => _confirmBulk = ActivityStatus.Draft" disabled="@_busy">All to draft</button>
                    <button class="btn small ghost" @onclick="() => _confirmBulk = ActivityStatus.Open" disabled="@_busy">All to open</button>
                }
                else
                {
                    <span class="muted">Set all @_event.Activities.Count activities to @(_confirmBulk == ActivityStatus.Draft ? "Draft" : "Open")?</span>
                    <button class="btn small danger" @onclick="ResetActivitiesAsync" disabled="@_busy">Yes</button>
                    <button class="btn small ghost" @onclick="() => _confirmBulk = null" disabled="@_busy">Cancel</button>
                }
            </div>
        </div>
    }

    @if (State.IsHost && !ProxyHere)
    {
        <div class="card stack accent">
            <h3>Players &amp; event admins</h3>
            <p class="muted">Pick players from your roster, and tick <b>admin</b> to make someone a co-host. Manage the roster under <a href="admin/users">People</a>.</p>
            @if (_allUsers.Count == 0)
            {
                <p class="muted">No people in the roster yet.</p>
            }
            else
            {
                @foreach (var u in _allUsers)
                {
                    <div class="row" style="font-weight:500">
                        <label class="row grow" style="font-weight:500">
                            <input type="checkbox" style="width:auto;min-height:auto"
                                   checked="@_selectedMemberIds.Contains(u.Id)"
                                   @onchange="e => ToggleMember(u.Id, (bool)e.Value!)" />
                            <span class="grow">@u.Name</span>
                        </label>
                        @if (_selectedMemberIds.Contains(u.Id))
                        {
                            <label class="muted" style="font-weight:500;font-size:.85rem">
                                <input type="checkbox" style="width:auto;min-height:auto"
                                       checked="@_selectedAdminIds.Contains(u.Id)"
                                       @onchange="e => ToggleAdmin(u.Id, (bool)e.Value!)" /> admin
                            </label>
                        }
                    </div>
                }
                <button class="btn block success" @onclick="SaveMembersAsync" disabled="@_busy">Save players</button>
            }
        </div>
    }

    @if (State.IsHost && _event.HasRoster && !ProxyHere)
    {
        <div class="card stack accent">
            <h3>Play for a player</h3>
            <p class="muted">If someone's phone dies or runs out of battery, take over here — you'll answer, score and slap as them on your own device. Tap Stop to go back to being yourself.</p>
            @foreach (var m in _event.Members)
            {
                <div class="row" style="border-bottom:1px solid var(--line);padding:.45rem 0">
                    <span class="grow" style="font-weight:500">@m.Name</span>
                    @if (ProxyHere && State.Proxy!.UserId == m.Id)
                    {
                        <span class="badge admin">Playing as</span>
                        <button class="btn small" @onclick="StopPlayingAsAsync" disabled="@_busy">Stop</button>
                    }
                    else
                    {
                        <button class="btn small secondary" @onclick="() => PlayAsAsync(m.Id)"
                                disabled="@(_busy || State.IsProxying)">Play as</button>
                    }
                </div>
            }
        </div>
    }

    @if (CanManage && !ProxyHere)
    {
        <div class="card stack accent">
            <h3>Event details</h3>
            <div class="field">
                <label>Event code (players type this to join)</label>
                <div class="row">
                    <input class="grow code-input" style="font-size:1.1rem;height:52px;letter-spacing:.15em"
                           @bind="_editCode" maxlength="16" />
                    <button class="btn small" @onclick="SaveCodeAsync" disabled="@_busy">Set</button>
                    <button class="btn small secondary" @onclick="RegenerateCodeAsync" disabled="@_busy">New</button>
                </div>
            </div>
            <div class="field">
                <label>Name</label>
                <input @bind="_editName" maxlength="200" />
            </div>
            <div class="field">
                <label>Available (optional — when players can join &amp; play)</label>
                <div class="row wrap">
                    <input type="datetime-local" value="@LocalInput(_editStartsAt)" @onchange="e => _editStartsAt = ParseLocal(e.Value)" />
                    <span class="muted">to</span>
                    <input type="datetime-local" value="@LocalInput(_editEndsAt)" @onchange="e => _editEndsAt = ParseLocal(e.Value)" />
                </div>
                <p class="muted" style="font-size:.8rem">Outside this window players see "starts at…/ended" and can't join or play — you always have access. Leave blank for always-on.</p>
            </div>
            <div class="field">
                <label>Rules / info</label>
                <RichTextEditor @key="_event.Id" Value="@_editDescription" ValueChanged="v => _editDescription = v"
                                Placeholder="Explain how the event works — use the toolbar for bullet lists" />
            </div>
            <div class="field">
                <label>Players per team</label>
                <input type="number" min="1" max="20" @bind="_editTeamSize" style="width:120px" />
            </div>
            @if (_editTeamSize > 1)
            {
                <div class="field">
                    <label>Teams (how partners are decided)</label>
                    <select @bind="_editTeamShuffle" @bind:after="OnTeamModeChangedAsync">
                        <option value="@TeamShuffle.EveryActivity">Shuffle every activity — fresh partners each round</option>
                        <option value="@TeamShuffle.FixedForEvent">Fixed teams — the same teams play the whole event</option>
                    </select>
                </div>
                @if (_editTeamShuffle == TeamShuffle.FixedForEvent)
                {
                    <div class="field">
                        <div class="row">
                            <span class="grow muted" style="font-size:.85rem">These teams play every activity.</span>
                            <button class="btn small secondary" type="button" @onclick="ShuffleTeamsAsync" disabled="@_busy">Shuffle teams</button>
                        </div>
                        @if (_fixedTeams.Count > 0)
                        {
                            <ul class="list">
                                @foreach (var t in _fixedTeams)
                                {
                                    <li><span class="grow">@t.Name</span></li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="muted" style="font-size:.85rem">Add players to the roster below, then shuffle to form teams.</p>
                        }
                    </div>
                }
            }
            <div class="field">
                <label>Scoring (how the event total is calculated)</label>
                <select @bind="_editScoring">
                    <option value="@EventScoring.Placement">Placement — 1st = number of teams, then 3, 2, 1</option>
                    <option value="@EventScoring.Cumulative">Cumulative — sum of actual activity points</option>
                </select>
                @if (_editScoring == EventScoring.Cumulative
                     && _event.Activities.Any(a => a.ScoringMode is ScoringMode.LowerWins or ScoringMode.ClosestToTarget))
                {
                    <div class="alert" style="background:var(--coral-50);color:var(--coral-700);border:1px solid var(--coral-100);font-size:.85rem;margin-top:.4rem">
                        Heads up: some activities are scored <b>lowest-wins</b> (a time, or a “Pin the city” distance).
                        Cumulative just adds the raw values, so those won't combine sensibly with points totals —
                        pick <b>Placement</b> for a mixed day.
                    </div>
                }
            </div>
            <div class="field">
                <label>Slaps (make it spicy — winner of each activity slaps a rival)</label>
                <select @bind="_editSlapMode">
                    <option value="@SlapMode.Off">Off</option>
                    <option value="@SlapMode.Vanish">On — halve a rival's lead, points vanish</option>
                    <option value="@SlapMode.SendToPlayer">On — halve a rival's lead, give the points to someone</option>
                    <option value="@SlapMode.SlappedSends">On — halve a rival's lead, the slapped player passes the points on</option>
                    <option value="@SlapMode.Random">On — random (vanish or give) each activity</option>
                </select>
            </div>
            <div class="field">
                <label>Picture / map</label>
                <ImageUploader Value="@_editImage" ValueChanged="v => _editImage = v" />
            </div>
            <button class="btn block success" @onclick="SaveEventAsync" disabled="@_busy">Save event details</button>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private EventDto? _event;
    private EventStandingsDto? _standings;

    // Per-activity slap ceremony shown inline under each finished activity (activityId → slap).
    private readonly Dictionary<int, ActivitySlapDto> _slapByActivity = new();
    private string? _eventName;
    private int? _userId;
    private readonly Dictionary<int, string> _teamByActivity = new();
    private ScoreboardConnection? _conn;
    private int _loadedId = -1;
    private bool _loading = true;
    private bool _reconnecting;

    private GeolocationInterop? _geo;
    private VibrationInterop? _vibe;
    private GeoPosition? _pos;
    private readonly Dictionary<int, double> _distances = new();
    private readonly HashSet<int> _arrived = new();
    private int? _arrivedPromptId;
    private bool _geoFailed;
    private bool _geoPrimed;

    private string _joinName = string.Empty;
    private string? _joinError;
    private bool _busy;

    private string _newTitle = string.Empty;
    private ActivityType _newType = ActivityType.Quiz;
    private string? _adminError;

    private List<UserDto> _allUsers = new();
    private HashSet<int> _selectedMemberIds = new();
    private HashSet<int> _selectedAdminIds = new();
    private bool _isEventAdmin;

    private List<ActivityDto> _library = new();
    private int _libSourceId;
    private bool _confirmRestart;
    private ActivityStatus? _confirmBulk;
    private int? _confirmDeleteId;
    private bool _isViewer;
    private string _viewerName = string.Empty;

    private bool CanManage => State.IsHost || _isEventAdmin;

    private string _editName = string.Empty;
    private string? _editDescription;
    private string? _editImage;
    private int _editTeamSize = 2;
    private EventScoring _editScoring = EventScoring.Cumulative;
    private TeamShuffle _editTeamShuffle = TeamShuffle.EveryActivity;
    private List<TeamDto> _fixedTeams = new();
    private SlapMode _editSlapMode = SlapMode.Off;
    private DateTime? _editStartsAt;
    private DateTime? _editEndsAt;
    private string _editCode = string.Empty;

    // --- Availability window ---------------------------------------------------------------
    // True when "now" is inside the event's window (or it has no window).
    private bool EventAvailableNow => _event is null
        || ((_event.StartsAt is not { } s || DateTime.Now >= s)
            && (_event.EndsAt is not { } e || DateTime.Now <= e));

    // The window gates players only — the host (CanManage) always has access.
    private bool EventOpenForMe => EventAvailableNow || CanManage;

    // Fixed culture so the English copy around these labels isn't mixed with browser-localised names.
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private static string LocalInput(DateTime? d) => d?.ToString("yyyy-MM-ddTHH:mm", Inv) ?? string.Empty;
    private static DateTime? ParseLocal(object? v) =>
        DateTime.TryParse(v?.ToString(), out var d) ? d : null;

    // "Sat 9 Jun, 10:00–16:00" / "From …" / "Until …", or null if no window set.
    private string? ScheduleText()
    {
        if (_event is null || (_event.StartsAt is null && _event.EndsAt is null))
        {
            return null;
        }

        if (_event.StartsAt is { } st && _event.EndsAt is { } en)
        {
            return st.Date == en.Date
                ? $"{st.ToString("ddd d MMM, HH:mm", Inv)}–{en.ToString("HH:mm", Inv)}"
                : $"{st.ToString("ddd d MMM HH:mm", Inv)} – {en.ToString("ddd d MMM HH:mm", Inv)}";
        }

        return _event.StartsAt is { } s
            ? $"From {s.ToString("ddd d MMM, HH:mm", Inv)}"
            : $"Until {_event!.EndsAt!.Value.ToString("ddd d MMM, HH:mm", Inv)}";
    }

    // Shown to players who are outside the window (the host never sees this).
    private string AvailabilityMessage() => _event?.StartsAt is { } s && DateTime.Now < s
        ? $"This event opens {s.ToString("dddd d MMM 'at' HH:mm", Inv)} — you'll be able to join then."
        : "This event has ended — you can look around, but can't join or play.";

    // DateTime.Now is only read at render, and nothing re-renders purely on the clock — so while a window
    // boundary is still ahead, tick every 30s to lift/close the gate on time, then stop.
    private System.Threading.Timer? _clock;

    private bool BoundaryPending => _event is not null
        && ((_event.StartsAt is { } s2 && DateTime.Now < s2) || (_event.EndsAt is { } e2 && DateTime.Now < e2));

    private void EnsureClock()
    {
        if (!BoundaryPending || _clock is not null)
        {
            return;
        }

        _clock = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            StateHasChanged();
            if (!BoundaryPending)
            {
                _clock?.Dispose();
                _clock = null;
            }
        }), null, 30_000, 30_000);
    }

    private int _slapTarget;
    private int _slapRecipient;

    // Collapsed-by-default state of the event-info blurb once the event is underway.
    private bool _eventInfoOpen;

    // The event is "underway" once any activity has been started (is live or already finished).
    // At that point the long event blurb folds into an accordion to save vertical space.
    private bool EventUnderway =>
        _event is not null && _event.Activities.Any(a => a.Status is ActivityStatus.Live or ActivityStatus.Finished);

    // True when this device is currently playing as another player in THIS event.
    private bool ProxyHere => State.IsProxying && State.Proxy!.EventId == Id;

    // The user id we're acting as: the proxied player if covering one, else our own claim.
    private int? ActingUserId => ProxyHere ? State.Proxy!.UserId : _userId;

    // The team the proxied player is on for this activity (null when not proxying or not covered).
    private string? ProxyTeam(int activityId) =>
        ProxyHere && State.Proxy!.Sessions.TryGetValue(activityId, out var s) && !string.IsNullOrEmpty(s.DisplayName)
            ? s.DisplayName
            : null;

    private bool IsMe(string name) =>
        string.Equals(name, _eventName, StringComparison.Ordinal)
        || (ProxyHere && string.Equals(name, State.Proxy!.Name, StringComparison.Ordinal));

    // Only the designated slapper (lowest overall score on the winning team) takes the slap.
    private bool CanSlap(PendingSlapDto slap) => ActingUserId is { } uid && slap.SlapperUserId == uid;
    private IEnumerable<SlapPersonDto> SlapTargets(PendingSlapDto slap) =>
        slap.Members.Where(m => !slap.WinnerUserIds.Contains(m.UserId));
    private IEnumerable<SlapPersonDto> SlapRecipients(PendingSlapDto slap) =>
        // Exclude both who we're acting as and our own real identity, so a proxying host
        // can't route the points to themselves. (_userId == ActingUserId when not proxying.)
        slap.Members.Where(m => m.UserId != ActingUserId && m.UserId != _userId && m.UserId != _slapTarget);

    private static string SlapBlurb(SlapMode mode) => mode switch
    {
        SlapMode.Vanish => "the winner halves a rival's lead — those points vanish.",
        SlapMode.SendToPlayer => "the winner halves a rival's lead — and hands the points to someone.",
        SlapMode.SlappedSends => "the winner halves a rival's lead — then the slapped player passes those points to someone.",
        SlapMode.Random => "the winner halves a rival's lead — points vanish or get passed on (random each round).",
        _ => "",
    };

    private string WinnerLine()
    {
        var winners = _standings?.Entries.Where(e => e.Rank == 1).Select(e => e.DisplayName).ToList() ?? new();
        if (winners.Count == 0)
        {
            return "Final results";
        }

        return winners.Count == 1 ? $"{winners[0]} wins!" : $"{string.Join(" & ", winners)} tie for the win!";
    }

    private string ScoringLabel => _event?.Scoring == EventScoring.Placement
        ? "Placement points — your team's position each activity (1st = most), summed."
        : "Cumulative — your team's actual points across all activities, summed.";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await TeardownAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await State.EnsureInitializedAsync(Api);

        // A "play as" overlay is scoped to one event — drop a stale one from another event
        // BEFORE the first API call, so its member token isn't sent for a different event.
        if (State.IsProxying && State.Proxy!.EventId != Id)
        {
            await State.ClearProxyAsync();
        }

        _event = await Api.GetEventAsync(Id);

        if (_event is not null)
        {
            // Remember this as the device's event so the landing page sends us straight back here.
            await State.SaveLastEventIdAsync(Id);

            // Decide the blurb's collapsed state ONCE, from the state at load: already underway
            // → start collapsed; not yet → start open and stay open (a later activity going Live
            // via SignalR must not yank the blurb closed while someone is reading it).
            _eventInfoOpen = !EventUnderway;
            SyncEditFields();
            _isViewer = await State.GetViewerAsync(Id);
            if (_isViewer)
            {
                _viewerName = await State.GetViewerNameAsync(Id) ?? string.Empty;
                var viewerToken = await State.GetViewerTokenAsync(Id);
                if (!string.IsNullOrWhiteSpace(_viewerName))
                {
                    try
                    {
                        var res = await Api.RegisterViewerAsync(Id, _viewerName, viewerToken); // heartbeat
                        await State.SaveViewerAsync(Id, res.Name, res.Token);
                    }
                    catch (ApiException) { }
                }
            }

            if (_event.HasRoster)
            {
                _userId = await State.GetEventUserIdAsync(Id);
                _eventName = await State.GetEventNameAsync(Id);
                if (_userId is not null)
                {
                    await ReclaimAsync();
                }
            }
            else
            {
                _eventName = await State.GetEventNameAsync(Id);
                if (_eventName is not null)
                {
                    await EnsureFreeNameSessionsAsync();
                }
            }

            if (State.IsHost)
            {
                try { _allUsers = await Api.ListUsersAsync(); } catch (ApiException) { }
                try { _library = await Api.GetLibraryAsync(); } catch (ApiException) { }
                _selectedMemberIds = _event.Members.Select(m => m.Id).ToHashSet();
                _selectedAdminIds = _event.AdminUserIds.ToHashSet();
            }

            if (CanManage && _event.TeamShuffle == TeamShuffle.FixedForEvent)
            {
                await LoadFixedTeamsAsync();
            }

            // If we're covering a player, refresh their sessions so any newly opened activity is included.
            await RefreshProxyAsync();

            _standings = await Api.GetEventStandingsAsync(Id);
            await LoadSlapsAsync();
            await StartConnectionAsync();
            await StartGeoAsync();
            EnsureClock();
        }

        _loading = false;
    }

    private async Task StartGeoAsync()
    {
        // Spectators don't need tracking. It powers the arrival prompt and the geofence auto-start —
        // so also track when there's a tipspromenad (its geofences live on the questions, not the activity).
        if (_event is null || _isViewer || _geo is not null
            || !_event.Activities.Any(a => a.HasLocation || a.Type == ActivityType.Tipspromenad))
        {
            return;
        }

        _geo = new GeolocationInterop(JS);
        _vibe = new VibrationInterop(JS);
        _geo.PositionChanged += OnGeo;
        _geo.ErrorOccurred += OnGeoError;
        _geoFailed = false;
        try { await _geo.StartAsync(); }
        catch { _geoFailed = true; }

        // Seed a one-shot fix so a stationary player (already at the spot when it opens) is caught
        // before the watch delivers its first position.
        try { OnGeo(await _geo.GetCurrentAsync()); } catch { /* no fix yet */ }
    }

    private void OnGeo(GeoPosition p) => _ = InvokeAsync(() =>
    {
        _pos = p;
        _geoFailed = false;
        if (_event is not null)
        {
            foreach (var a in _event.Activities.Where(a => a.HasLocation))
            {
                _distances[a.Id] = GeolocationInterop.DistanceMeters(
                    p.Latitude, p.Longitude, a.Latitude!.Value, a.Longitude!.Value);
                // Leaving the radius re-arms the prompt so a genuine re-entry fires again.
                if (!WithinRadius(a))
                {
                    _arrived.Remove(a.Id);
                }
            }

            // On the first fix after the page opens, treat activities you're ALREADY inside (and already
            // open) as seen — landing back on this page shouldn't pop "You've arrived" for where you stand.
            if (!_geoPrimed)
            {
                _geoPrimed = true;
                foreach (var a in _event.Activities)
                {
                    if (a.HasLocation && a.Status is ActivityStatus.Open or ActivityStatus.Live && WithinRadius(a))
                    {
                        _arrived.Add(a.Id);
                    }
                }
            }

            CheckArrivals();
            _ = MaybeReportArrivalAsync(p); // server starts any open activity/station geofence we've entered
        }

        StateHasChanged();
        return Task.CompletedTask;
    });

    // Report our GPS so the server auto-starts any open activity (or tipspromenad station) we've
    // walked into. Throttled, and only when there's actually an open geofenced activity to start.
    private DateTimeOffset _lastArrivePost = DateTimeOffset.MinValue;
    private async Task MaybeReportArrivalAsync(GeoPosition p)
    {
        if (_event is null
            || !_event.Activities.Any(a => a.Status == ActivityStatus.Open && (a.HasLocation || a.Type == ActivityType.Tipspromenad))
            || DateTimeOffset.UtcNow - _lastArrivePost < TimeSpan.FromSeconds(8))
        {
            return;
        }

        _lastArrivePost = DateTimeOffset.UtcNow;
        try
        {
            // The SignalR status push from a started activity refreshes everyone, so no need to act on the result.
            await Api.ReportArrivalAsync(Id, p.Latitude, p.Longitude);
        }
        catch (ApiException) { /* transient — the next fix retries */ }
    }

    private void OnGeoError(string message) => _ = InvokeAsync(() =>
    {
        _geoFailed = true;
        StateHasChanged();
        return Task.CompletedTask;
    });

    // Raises the "you've arrived" prompt the first time the player is within a ready (Open/Live)
    // activity's radius — also catches a stationary player when the host opens the activity they're at.
    private void CheckArrivals()
    {
        // Player-only: skip spectators and a host who isn't playing (no own/free-name identity),
        // so the full-screen overlay never interrupts spectating or the Host controls.
        if (_event is null || _isViewer || (_userId is null && _eventName is null))
        {
            return;
        }

        foreach (var a in _event.Activities)
        {
            if (a.HasLocation && a.Status is ActivityStatus.Open or ActivityStatus.Live
                && _distances.TryGetValue(a.Id, out var d) && d <= RadiusOf(a) && _arrived.Add(a.Id))
            {
                _ = _vibe?.PatternAsync(90, 50, 140);
                _arrivedPromptId ??= a.Id; // earliest arrival in a tick wins; the rest follow on dismiss
            }
        }
    }

    private void DismissArrival() => _arrivedPromptId = null;

    private void GoToActivity(int activityId)
    {
        _arrivedPromptId = null;
        Nav.NavigateTo($"a/{activityId}");
    }

    private static string ConfettiColor(int i) =>
        new[] { "var(--coral-400)", "var(--sun-400)", "var(--green-300)", "#fff", "var(--sea-200)" }[i % 5];

    private static string ActivityMapsUrl(ActivityDto a)
    {
        var lat = a.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = a.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"https://www.google.com/maps/dir/?api=1&destination={lat},{lng}&travelmode=walking";
    }

    private static int RadiusOf(ActivityDto a) => a.RadiusMeters is > 0 ? a.RadiusMeters.Value : 25;
    private bool WithinRadius(ActivityDto a) => _distances.TryGetValue(a.Id, out var d) && d <= RadiusOf(a);

    // Open/Live activity with a geofence the player has a fix for but isn't inside yet (so it's "walk there").
    private bool IsLocked(ActivityDto a) =>
        (a.Status is ActivityStatus.Live or ActivityStatus.Open) && a.HasLocation
        && !_geoFailed && _distances.ContainsKey(a.Id) && !WithinRadius(a);
    private string LockText(ActivityDto a) => _distances.TryGetValue(a.Id, out var d)
        ? $"Walk closer · {(int)Math.Round(d)} m"
        : "Walk to the spot";

    private void SyncEditFields()
    {
        if (_event is null) return;
        _editName = _event.Name;
        _editDescription = _event.Description;
        _editImage = _event.ImageUrl;
        _editTeamSize = _event.TeamSize;
        _editScoring = _event.Scoring;
        _editTeamShuffle = _event.TeamShuffle;
        _editSlapMode = _event.SlapMode;
        _editStartsAt = _event.StartsAt;
        _editEndsAt = _event.EndsAt;
        _editCode = _event.JoinCode;
    }

    private async Task SaveCodeAsync()
    {
        _busy = true;
        _adminError = null;
        try
        {
            _event = await Api.SetEventCodeAsync(Id, _editCode.Trim());
            SyncEditFields();
        }
        catch (ApiException ex)
        {
            _adminError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RegenerateCodeAsync()
    {
        _busy = true;
        _adminError = null;
        try
        {
            _event = await Api.SetEventCodeAsync(Id, null);
            SyncEditFields();
        }
        catch (ApiException ex)
        {
            _adminError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartConnectionAsync()
    {
        if (_event is null) return;
        _conn = new ScoreboardConnection(Nav, State);
        _conn.ScoreboardUpdated += OnRealtimeScore;
        _conn.StatusChanged += OnRealtimeStatus;
        _conn.ViewersChanged += OnRealtimeViewers;
        _conn.EventChanged += OnRealtimeEventChanged;
        _conn.ConnectionStateChanged += OnConnectionStateChanged;
        try
        {
            await _conn.StartAsync(_event.Activities.Select(a => a.Id));
            await _conn.JoinEventAsync(Id);
        }
        catch { /* live updates unavailable */ }
    }

    private void OnRealtimeScore(ScoreboardDto _) => RefreshSoon();
    private void OnRealtimeStatus(ActivityStatusChangedDto _) => RefreshSoon();

    private void OnRealtimeViewers(EventViewersDto v) => _ = InvokeAsync(() =>
    {
        if (_event is not null && v.EventId == Id)
        {
            _event.Viewers = v.Viewers;
            StateHasChanged();
        }
    });
    // The host changed this event's roster/admins — re-fetch (RefreshAsync re-claims, so a player
    // just made/unmade an admin sees their host controls appear/disappear without a manual reload).
    private void OnRealtimeEventChanged(int eventId)
    {
        if (eventId == Id)
        {
            RefreshSoon();
        }
    }

    private void RefreshSoon() => _ = InvokeAsync(RefreshAsync);

    // Fetch the slap ceremony for each finished activity so it can show inline in the running order.
    private async Task LoadSlapsAsync()
    {
        _slapByActivity.Clear();
        if (_event is null || _event.SlapMode == SlapMode.Off)
        {
            return;
        }

        foreach (var a in _event.Activities.Where(a => a.Status == ActivityStatus.Finished))
        {
            try
            {
                var slap = await Api.GetActivitySlapAsync(a.Id);
                if (slap is { State: not SlapState.None })
                {
                    _slapByActivity[a.Id] = slap;
                }
            }
            catch (ApiException) { /* skip this one on a transient error */ }
        }
    }

    private async Task OnInlineSlapChangedAsync()
    {
        await LoadSlapsAsync();
        _standings = await Api.GetEventStandingsAsync(Id); // the slap shifted the standings
        StateHasChanged();
    }

    private async Task RefreshAsync()
    {
        _event = await Api.GetEventAsync(Id) ?? _event;
        _standings = await Api.GetEventStandingsAsync(Id);
        await LoadSlapsAsync();

        // An activity may have just opened (or gained a location) — start tracking if needed and
        // re-check arrivals so a player already at the spot is prompted right away.
        await StartGeoAsync();
        if (_event is not null)
        {
            // A finished/paused activity re-arms, so re-opening it later can prompt again.
            foreach (var a in _event.Activities.Where(a => a.Status is not (ActivityStatus.Open or ActivityStatus.Live)))
            {
                _arrived.Remove(a.Id);
            }
        }

        CheckArrivals();
        EnsureClock();

        if (_conn is not null && _event is not null)
        {
            foreach (var a in _event.Activities)
            {
                await _conn.EnsureJoinedAsync(a.Id);
            }
        }

        if (_event?.HasRoster == true && _userId is not null)
        {
            await ReclaimAsync();
        }
        else if (_event?.HasRoster == false && _eventName is not null)
        {
            await EnsureFreeNameSessionsAsync();
        }

        // Keep the covered player's sessions current as activities open/close.
        await RefreshProxyAsync();

        StateHasChanged();
    }

    private void OnConnectionStateChanged()
    {
        _reconnecting = _conn?.IsReconnecting ?? false;
        InvokeAsync(StateHasChanged);
    }

    // ---- Roster claim ----
    private async Task ClaimAsync(int userId)
    {
        if (_event is null) return;
        _busy = true;
        _joinError = null;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, userId);
            _userId = userId;
            _eventName = res.DisplayName;
            _isEventAdmin = res.IsEventAdmin;
            State.ActiveMemberToken = res.MemberToken;
            await State.SaveEventUserIdAsync(Id, userId);
            await State.SaveEventNameAsync(Id, res.DisplayName);
            await State.SaveEventMemberTokenAsync(Id, res.MemberToken);
            await StoreSlotsAsync(res.Slots);
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _joinError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReclaimAsync()
    {
        if (_event is null || _userId is not int uid) return;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, uid);
            _eventName = res.DisplayName;
            _isEventAdmin = res.IsEventAdmin;
            State.ActiveMemberToken = res.MemberToken;
            await State.SaveEventMemberTokenAsync(Id, res.MemberToken);
            await StoreSlotsAsync(res.Slots);
        }
        catch (ApiException) { }
    }

    private async Task StoreSlotsAsync(List<EventJoinSlotDto> slots)
    {
        foreach (var slot in slots)
        {
            _teamByActivity[slot.ActivityId] = slot.TeamName;
            await State.SaveSessionAsync(slot.ActivityId, PlayerSession.FromSlot(slot, slot.TeamName));
        }
    }

    // ---- Host: play for another player (their phone died) ----
    private async Task PlayAsAsync(int userId)
    {
        if (_event is null) return;
        _busy = true;
        _adminError = null;
        StateHasChanged(); // reflect the disabled buttons before the network round-trip
        try
        {
            // Claim the player's identity (idempotent, stable team tokens) and overlay it.
            var res = await Api.ClaimAsync(_event.JoinCode, userId);
            await State.SetProxyAsync(BuildProxy(userId, res));
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _adminError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // Re-claim the proxied player so activities opened AFTER we started covering them
    // also get that player's team session (claim only returns Open/Live activities).
    // Cheap-guarded: only re-claims when some playable activity isn't covered yet, so it
    // doesn't fire a claim on every scoreboard refresh.
    private async Task RefreshProxyAsync()
    {
        if (_event is null || !ProxyHere) return;

        var missingPlayable = _event.Activities
            .Where(a => a.Status is ActivityStatus.Open or ActivityStatus.Live)
            .Any(a => !State.Proxy!.Sessions.ContainsKey(a.Id));
        if (!missingPlayable) return;

        var uid = State.Proxy!.UserId;
        try
        {
            var res = await Api.ClaimAsync(_event.JoinCode, uid);
            await State.SetProxyAsync(BuildProxy(uid, res));
        }
        catch (ApiException) { }
    }

    private ProxyIdentity BuildProxy(int userId, ClaimResultDto res) => new()
    {
        EventId = Id,
        UserId = userId,
        Name = res.DisplayName,
        MemberToken = res.MemberToken,
        Sessions = res.Slots.ToDictionary(s => s.ActivityId, s => PlayerSession.FromSlot(s, s.TeamName)),
    };

    private async Task StopPlayingAsAsync()
    {
        _busy = true;
        StateHasChanged();
        await State.ClearProxyAsync();
        // Force a reload so any open activity page re-reads our own (restored) session.
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    // ---- Free-name join (rosterless events) ----
    private async Task JoinFreeNameAsync()
    {
        var name = _joinName.Trim();
        if (name.Length == 0 || _event is null) return;
        _busy = true;
        _joinError = null;
        try
        {
            var result = await Api.JoinEventAsync(_event.JoinCode, name);
            await State.SaveEventNameAsync(Id, name);
            _eventName = name;
            await SaveFreeNameSlotsAsync(result, name);
            _standings = await Api.GetEventStandingsAsync(Id);
        }
        catch (ApiException ex)
        {
            _joinError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EnsureFreeNameSessionsAsync()
    {
        if (_event is null || _eventName is null) return;
        try
        {
            var result = await Api.JoinEventAsync(_event.JoinCode, _eventName);
            await SaveFreeNameSlotsAsync(result, _eventName);
        }
        catch (ApiException) { }
    }

    // Persist a per-activity session for each joinable slot under one free-name identity.
    private async Task SaveFreeNameSlotsAsync(EventJoinResultDto result, string displayName)
    {
        foreach (var slot in result.Slots)
        {
            await State.SaveSessionAsync(slot.ActivityId, PlayerSession.FromSlot(slot, displayName));
        }
    }

