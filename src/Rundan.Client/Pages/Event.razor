@page "/e/{Id:int}"
@implements IAsyncDisposable
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_event?.Name ?? "Event") · Rundan</PageTitle>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else if (_event is null)
{
    <div class="card">
        <h1>Not found</h1>
        <p class="muted">No event with that code or id.</p>
        <a class="btn" href="">Back to start</a>
    </div>
}
else
{
    <div class="card stack">
        <div class="row">
            <h1 class="grow">@_event.Name</h1>
            @if (_reconnecting)
            {
                <span class="badge">Reconnecting…</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(_event.ImageUrl))
        {
            <img src="@_event.ImageUrl" alt="" style="width:100%;border-radius:var(--radius-md)" />
        }
        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            <p style="white-space:pre-wrap">@_event.Description</p>
        }
        <div class="row muted" style="font-size:.85rem">
            <span>Event code @_event.JoinCode</span>
            <span>·</span>
            <span>Teams of @_event.TeamSize</span>
        </div>
    </div>

    @if (_event.PendingSlap is { } slap)
    {
        <div class="card stack accent">
            <h2>Slap time!</h2>
            <p><b>@slap.WinnerName</b> won “@slap.ActivityTitle” — @SlapBlurb(_event.SlapMode) The next activity can't start until this is done.</p>

            @if (CanSlap(slap))
            {
                @if (_adminError is not null)
                {
                    <div class="alert error">@_adminError</div>
                }
                <div class="field">
                    <label>Slap a rival</label>
                    <select @bind="_slapTarget">
                        <option value="0">Pick someone…</option>
                        @foreach (var p in SlapTargets(slap))
                        {
                            <option value="@p.UserId">@p.Name</option>
                        }
                    </select>
                </div>
                @if (slap.EffectiveMode == SlapMode.SendToPlayer)
                {
                    <div class="field">
                        <label>Give the points to</label>
                        <select @bind="_slapRecipient">
                            <option value="0">Pick someone…</option>
                            @foreach (var p in SlapRecipients(slap))
                            {
                                <option value="@p.UserId">@p.Name</option>
                            }
                        </select>
                    </div>
                }
                <button class="btn block success" @onclick="() => PerformSlapAsync(slap)"
                        disabled="@(_busy || _slapTarget == 0 || (slap.EffectiveMode == SlapMode.SendToPlayer && _slapRecipient == 0))">
                    Slap!
                </button>
            }
            else
            {
                <p class="muted">Waiting for @slap.WinnerName to take the slap…</p>
            }

            @if (CanManage)
            {
                <button class="btn ghost small" @onclick="() => SkipSlapAsync(slap)" disabled="@_busy">Skip slap (host)</button>
            }
        </div>
    }

    @if (_event.IsComplete && _standings is not null && _standings.Entries.Count > 0)
    {
        <div class="card stack center final-results">
            <span class="final-badge">Final results</span>
            <h2 style="margin:.3rem 0">@WinnerLine()</h2>
            <p class="muted">@_event.Name is done — thanks for playing!</p>
            <div class="podium">
                @foreach (var e in _standings.Entries.Take(3))
                {
                    <div class="podium-spot p@(e.Rank)">
                        <div class="medal">@e.Rank</div>
                        <div class="who">@e.DisplayName</div>
                        <div class="pts">@Fmt.Num(e.TotalPoints) p</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card">
        <h2>@(_event.IsComplete ? "Final standings" : "Total standings")</h2>
        <p class="muted" style="font-size:.8rem;margin-top:-.4rem">@ScoringLabel</p>
        @if (_standings is null || _standings.Entries.Count == 0)
        {
            <p class="muted center">No points yet — they add up across every activity.</p>
        }
        else
        {
            <div class="score-list">
                @foreach (var e in _standings.Entries)
                {
                    <div class="score-row @(IsMe(e.DisplayName) ? "me" : null) @(e.Rank == 1 ? "lead" : null)">
                        <div class="score-row__rank">@e.Rank</div>
                        <div class="score-row__name">
                            <b>@e.DisplayName @if (IsMe(e.DisplayName)) { <span class="you"> · You</span> }</b>
                            <span class="sub">@e.ActivitiesPlayed of @_event.Activities.Count activities</span>
                        </div>
                        <div class="score-row__score">@Fmt.Num(e.TotalPoints)</div>
                    </div>
                }
            </div>
        }
    </div>

    @* ---- Identity: viewer, or claim (roster) / free-name join ---- *@
    @if (_isViewer)
    {
        <div class="card stack center">
            <span class="badge">Viewer</span>
            <p class="muted">You're watching @_event.Name as <b>@_viewerName</b> — everything updates live, but you're not competing.</p>
            <button class="btn block secondary" @onclick="StopViewingAsync" disabled="@_busy">Join as a player instead</button>
        </div>
    }
    else if (_eventName is null)
    {
        @if (_joinError is not null)
        {
            <div class="alert error">@_joinError</div>
        }

        @if (_event.HasRoster)
        {
            <div class="card stack">
                <h2>Who are you?</h2>
                <p class="muted">Tap your name to join the event.</p>
                @foreach (var m in _event.Members)
                {
                    <button class="btn block secondary" @onclick="() => ClaimAsync(m.Id)" disabled="@_busy">@m.Name</button>
                }
            </div>
        }
        else
        {
            <div class="card stack">
                <h2>Join “@_event.Name”</h2>
                <p class="muted">Pick a name — you'll use it for every activity.</p>
                <input type="text" maxlength="60" placeholder="Your name" @bind="_joinName" @bind:event="oninput" />
                <button class="btn block" @onclick="JoinFreeNameAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_joinName))">
                    Join the event
                </button>
            </div>
        }

        <div class="card stack">
            <h3>Just watching?</h3>
            <p class="muted">Spectate everything live without competing.</p>
            <input type="text" maxlength="60" placeholder="Your name" @bind="_viewerName" @bind:event="oninput" />
            <button class="btn ghost block" @onclick="WatchAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_viewerName))">
                Watch as viewer
            </button>
        </div>
    }
    else
    {
        <div class="card center muted">You're playing as <b>@_eventName</b>.</div>
    }

    @if (_event.Viewers.Count > 0)
    {
        <div class="card">
            <h3>Watching now (@_event.Viewers.Count)</h3>
            <p class="muted">@string.Join(", ", _event.Viewers)</p>
        </div>
    }

    <div class="card">
        <h2>Activities</h2>
        @if (_event.Activities.Count == 0)
        {
            <p class="muted">No activities yet@(CanManage ? " — add the first one below." : ".")</p>
        }
        else
        {
            <ul class="list">
                @foreach (var a in _event.Activities)
                {
                    <li>
                        <span class="grow">
                            <b>@a.Order. @a.Title</b>
                            <span class="muted" style="font-size:.8rem"> · @Fmt.TypeLabel(a.Type)</span>
                            @if (_teamByActivity.TryGetValue(a.Id, out var team) && !string.IsNullOrEmpty(team))
                            {
                                <span class="sub" style="display:block;font-size:.8rem;color:var(--sea-600)">Your team: @team</span>
                            }
                        </span>
                        <StatusBadge Status="a.Status" />
                        @if (a.Status == ActivityStatus.Live && a.HasLocation && !WithinRadius(a))
                        {
                            <a class="btn ghost small" href="@ActivityMapsUrl(a)" target="_blank" rel="noopener">Maps</a>
                            <span class="muted" style="font-size:.82rem">@LockText(a)</span>
                        }
                        else if (a.Status is ActivityStatus.Live or ActivityStatus.Open or ActivityStatus.Finished)
                        {
                            <a class="btn small @(a.Status == ActivityStatus.Live ? "" : "secondary")" href="@($"a/{a.Id}")">
                                @ActionLabel(a.Status)
                            </a>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    @if (CanManage)
    {
        <div class="card stack accent">
            <h2>Host controls</h2>
            @if (_adminError is not null)
            {
                <div class="alert error">@_adminError</div>
            }

            @* Run order *@
            @foreach (var a in _event.Activities)
            {
                <div class="row" style="border-bottom:1px solid var(--line);padding:.4rem 0">
                    <span class="grow"><b>@a.Order. @a.Title</b> <StatusBadge Status="a.Status" /></span>
                    @foreach (var (label, status) in HostActions(a.Status))
                    {
                        <button class="btn small success" @onclick="() => SetStatusAsync(a.Id, status)"
                                disabled="@(_busy || (status == ActivityStatus.Live && _event.PendingSlap is not null && _event.PendingSlap.ActivityId != a.Id))">
                            @label
                        </button>
                    }
                    <button class="btn small secondary" @onclick="() => SimulateActivityAsync(a.Id)" disabled="@_busy">Simulate</button>
                    <a class="btn small ghost" href="@($"manage/{a.Id}")">Edit</a>
                </div>
            }

            <h3 style="margin-top:.5rem">Add an activity</h3>
            <input type="text" placeholder="Activity title" @bind="_newTitle" maxlength="200" />
            <select @bind="_newType">
                <option value="@ActivityType.Quiz">Quiz</option>
                <option value="@ActivityType.Tipspromenad">Tipspromenad (quiz walk)</option>
                <option value="@ActivityType.Boule">Boule (knockout)</option>
                <option value="@ActivityType.ScoreGame">Other score game</option>
                <option value="@ActivityType.WordGame">Word game</option>
            </select>
            <button class="btn block success" @onclick="AddActivityAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">
                Add to event
            </button>

            @if (State.IsHost && _library.Count > 0)
            {
                <h3 style="margin-top:.5rem">Reuse from library</h3>
                <p class="muted" style="font-size:.85rem">Add a copy of a public activity (rules, questions, scoring all carried over).</p>
                <select @bind="_libSourceId">
                    <option value="0">Pick a public activity…</option>
                    @foreach (var lib in _library)
                    {
                        <option value="@lib.Id">@lib.Title</option>
                    }
                </select>
                <button class="btn block secondary" @onclick="AddFromLibraryAsync" disabled="@(_busy || _libSourceId <= 0)">
                    Add a copy to this event
                </button>
            }

            <h3 style="margin-top:.5rem">Dry run</h3>
            <p class="muted" style="font-size:.85rem">Fill the activities with random results to check the scoreboards, bracket and standings work — then clear it before the real day.</p>
            <div class="row wrap">
                <button class="btn small secondary" @onclick="SimulateEventAsync" disabled="@_busy">Simulate all</button>
                @if (!_confirmClear)
                {
                    <button class="btn small ghost danger" @onclick="() => _confirmClear = true" disabled="@_busy">Clear all results</button>
                }
                else
                {
                    <span class="muted">Clear every result?</span>
                    <button class="btn small danger" @onclick="ClearAllResultsAsync" disabled="@_busy">Yes, clear</button>
                    <button class="btn small ghost" @onclick="() => _confirmClear = false">Cancel</button>
                }
            </div>
        </div>
    }

    @if (State.IsHost)
    {
        <div class="card stack accent">
            <h3>Players &amp; event admins</h3>
            <p class="muted">Pick players from your roster, and tick <b>admin</b> to make someone a co-host. Manage the roster under <a href="admin/users">People</a>.</p>
            @if (_allUsers.Count == 0)
            {
                <p class="muted">No people in the roster yet.</p>
            }
            else
            {
                @foreach (var u in _allUsers)
                {
                    <div class="row" style="font-weight:500">
                        <label class="row grow" style="font-weight:500">
                            <input type="checkbox" style="width:auto;min-height:auto"
                                   checked="@_selectedMemberIds.Contains(u.Id)"
                                   @onchange="e => ToggleMember(u.Id, (bool)e.Value!)" />
                            <span class="grow">@u.Name</span>
                        </label>
                        @if (_selectedMemberIds.Contains(u.Id))
                        {
                            <label class="muted" style="font-weight:500;font-size:.85rem">
                                <input type="checkbox" style="width:auto;min-height:auto"
                                       checked="@_selectedAdminIds.Contains(u.Id)"
                                       @onchange="e => ToggleAdmin(u.Id, (bool)e.Value!)" /> admin
                            </label>
                        }
                    </div>
                }
                <button class="btn block success" @onclick="SaveMembersAsync" disabled="@_busy">Save players</button>
            }
        </div>
    }

    @if (State.IsHost && _event.HasRoster)
    {
        <div class="card stack accent">
            <h3>Play for a player</h3>
            <p class="muted">If someone's phone dies or runs out of battery, take over here — you'll answer, score and slap as them on your own device. Tap Stop to go back to being yourself.</p>
            @foreach (var m in _event.Members)
            {
                <div class="row" style="border-bottom:1px solid var(--line);padding:.45rem 0">
                    <span class="grow" style="font-weight:500">@m.Name</span>
                    @if (ProxyHere && State.Proxy!.UserId == m.Id)
                    {
                        <span class="badge admin">Playing as</span>
                        <button class="btn small" @onclick="StopPlayingAsAsync" disabled="@_busy">Stop</button>
                    }
                    else
                    {
                        <button class="btn small secondary" @onclick="() => PlayAsAsync(m.Id)"
                                disabled="@(_busy || State.IsProxying)">Play as</button>
                    }
                </div>
            }
        </div>
    }

    @if (CanManage)
    {
        <div class="card stack accent">
            <h3>Event details</h3>
            <div class="field">
                <label>Event code (players type this to join)</label>
                <div class="row">
                    <input class="grow code-input" style="font-size:1.1rem;height:52px;letter-spacing:.15em"
                           @bind="_editCode" maxlength="16" />
                    <button class="btn small" @onclick="SaveCodeAsync" disabled="@_busy">Set</button>
                    <button class="btn small secondary" @onclick="RegenerateCodeAsync" disabled="@_busy">New</button>
                </div>
            </div>
            <div class="field">
                <label>Name</label>
                <input @bind="_editName" maxlength="200" />
            </div>
            <div class="field">
                <label>Rules / info</label>
                <textarea @bind="_editDescription" placeholder="Explain how the event works"></textarea>
            </div>
            <div class="field">
                <label>Players per team</label>
                <input type="number" min="1" max="20" @bind="_editTeamSize" style="width:120px" />
            </div>
            <div class="field">
                <label>Scoring (how the event total is calculated)</label>
                <select @bind="_editScoring">
                    <option value="@EventScoring.Placement">Placement — 1st = number of teams, then 3, 2, 1</option>
                    <option value="@EventScoring.Cumulative">Cumulative — sum of actual activity points</option>
                </select>
            </div>
            <div class="field">
                <label>Slaps (make it spicy — winner of each activity slaps a rival)</label>
                <select @bind="_editSlapMode">
                    <option value="@SlapMode.Off">Off</option>
                    <option value="@SlapMode.Vanish">On — halve a rival's lead, points vanish</option>
                    <option value="@SlapMode.SendToPlayer">On — halve a rival's lead, give the points to someone</option>
                    <option value="@SlapMode.Random">On — random (vanish or give) each activity</option>
                </select>
            </div>
            <div class="field">
                <label>Picture / map</label>
                <ImageUploader Value="_editImage" ValueChanged="v => _editImage = v" />
            </div>
            <button class="btn block success" @onclick="SaveEventAsync" disabled="@_busy">Save event details</button>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private EventDto? _event;
    private EventStandingsDto? _standings;
    private string? _eventName;
    private int? _userId;
    private readonly Dictionary<int, string> _teamByActivity = new();
    private ScoreboardConnection? _conn;
    private int _loadedId = -1;
    private bool _loading = true;
    private bool _reconnecting;

    private GeolocationInterop? _geo;
    private VibrationInterop? _vibe;
    private GeoPosition? _pos;
    private readonly Dictionary<int, double> _distances = new();
    private readonly HashSet<int> _arrived = new();

    private string _joinName = string.Empty;
    private string? _joinError;
    private bool _busy;

    private string _newTitle = string.Empty;
    private ActivityType _newType = ActivityType.Quiz;
    private string? _adminError;

    private List<UserDto> _allUsers = new();
    private HashSet<int> _selectedMemberIds = new();
    private HashSet<int> _selectedAdminIds = new();
    private bool _isEventAdmin;

    private List<ActivityDto> _library = new();
    private int _libSourceId;
    private bool _confirmClear;
    private bool _isViewer;
    private string _viewerName = string.Empty;

    private bool CanManage => State.IsHost || _isEventAdmin;

    private string _editName = string.Empty;
    private string? _editDescription;
    private string? _editImage;
    private int _editTeamSize = 2;
    private EventScoring _editScoring = EventScoring.Cumulative;
    private SlapMode _editSlapMode = SlapMode.Off;
    private string _editCode = string.Empty;

    private int _slapTarget;
    private int _slapRecipient;

    // True when this device is currently playing as another player in THIS event.
    private bool ProxyHere => State.IsProxying && State.Proxy!.EventId == Id;

    // The user id we're acting as: the proxied player if covering one, else our own claim.
    private int? ActingUserId => ProxyHere ? State.Proxy!.UserId : _userId;

    private bool IsMe(string name) =>
        string.Equals(name, _eventName, StringComparison.Ordinal)
        || (ProxyHere && string.Equals(name, State.Proxy!.Name, StringComparison.Ordinal));

    private bool CanSlap(PendingSlapDto slap) => ActingUserId is { } uid && slap.WinnerUserIds.Contains(uid);
    private IEnumerable<SlapPersonDto> SlapTargets(PendingSlapDto slap) =>
        slap.Members.Where(m => !slap.WinnerUserIds.Contains(m.UserId));
    private IEnumerable<SlapPersonDto> SlapRecipients(PendingSlapDto slap) =>
        // Exclude both who we're acting as and our own real identity, so a proxying host
        // can't route the points to themselves. (_userId == ActingUserId when not proxying.)
        slap.Members.Where(m => m.UserId != ActingUserId && m.UserId != _userId && m.UserId != _slapTarget);

    private static string SlapBlurb(SlapMode mode) => mode switch
    {
        SlapMode.Vanish => "the winner halves a rival's lead — those points vanish.",
        SlapMode.SendToPlayer => "the winner halves a rival's lead — and hands the points to someone.",
        SlapMode.Random => "the winner halves a rival's lead — points vanish or get passed on (random each round).",
        _ => "",
    };

    private string WinnerLine()
    {
        var winners = _standings?.Entries.Where(e => e.Rank == 1).Select(e => e.DisplayName).ToList() ?? new();
        if (winners.Count == 0)
        {
            return "Final results";
        }

        return winners.Count == 1 ? $"{winners[0]} wins!" : $"{string.Join(" & ", winners)} tie for the win!";
    }

    private string ScoringLabel => _event?.Scoring == EventScoring.Placement
        ? "Placement points — your team's position each activity (1st = most), summed."
        : "Cumulative — your team's actual points across all activities, summed.";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await TeardownAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await State.EnsureInitializedAsync(Api);

        // A "play as" overlay is scoped to one event — drop a stale one from another event
        // BEFORE the first API call, so its member token isn't sent for a different event.
        if (State.IsProxying && State.Proxy!.EventId != Id)
        {
            await State.ClearProxyAsync();
        }

        _event = await Api.GetEventAsync(Id);

        if (_event is not null)
        {
            SyncEditFields();
            _isViewer = await State.GetViewerAsync(Id);
            if (_isViewer)
            {
                _viewerName = await State.GetViewerNameAsync(Id) ?? string.Empty;
                var viewerToken = await State.GetViewerTokenAsync(Id);
                if (!string.IsNullOrWhiteSpace(_viewerName))
                {
                    try
                    {
                        var res = await Api.RegisterViewerAsync(Id, _viewerName, viewerToken); // heartbeat
                        await State.SaveViewerAsync(Id, res.Name, res.Token);
                    }
                    catch (ApiException) { }
                }
            }

            if (_event.HasRoster)
            {
                _userId = await State.GetEventUserIdAsync(Id);
                _eventName = await State.GetEventNameAsync(Id);
                if (_userId is not null)
                {
                    await ReclaimAsync();
                }
            }
            else
            {
                _eventName = await State.GetEventNameAsync(Id);
                if (_eventName is not null)
                {
                    await EnsureFreeNameSessionsAsync();
                }
            }

            if (State.IsHost)
            {
                try { _allUsers = await Api.ListUsersAsync(); } catch (ApiException) { }
                try { _library = await Api.GetLibraryAsync(); } catch (ApiException) { }
                _selectedMemberIds = _event.Members.Select(m => m.Id).ToHashSet();
                _selectedAdminIds = _event.AdminUserIds.ToHashSet();
            }

            // If we're covering a player, refresh their sessions so any newly opened activity is included.
            await RefreshProxyAsync();

            _standings = await Api.GetEventStandingsAsync(Id);
            await StartConnectionAsync();
            await StartGeoAsync();
        }

        _loading = false;
    }

    private async Task StartGeoAsync()
    {
        if (_event is null || _geo is not null || !_event.Activities.Any(a => a.HasLocation))
        {
            return;
        }

        _geo = new GeolocationInterop(JS);
        _vibe = new VibrationInterop(JS);
        _geo.PositionChanged += OnGeo;
        try { await _geo.StartAsync(); } catch { /* geolocation unavailable */ }
    }

    private void OnGeo(GeoPosition p) => _ = InvokeAsync(() =>
    {
        _pos = p;
        if (_event is not null)
        {
            foreach (var a in _event.Activities.Where(a => a.HasLocation))
            {
                var d = GeolocationInterop.DistanceMeters(p.Latitude, p.Longitude, a.Latitude!.Value, a.Longitude!.Value);
                _distances[a.Id] = d;
                if (a.Status == ActivityStatus.Live && d <= RadiusOf(a) && _arrived.Add(a.Id))
                {
                    _ = _vibe?.PatternAsync(90, 50, 140);
                }
            }
        }

        StateHasChanged();
        return Task.CompletedTask;
    });

    private static string ActivityMapsUrl(ActivityDto a)
    {
        var lat = a.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = a.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"https://www.google.com/maps/dir/?api=1&destination={lat},{lng}&travelmode=walking";
    }

    private static int RadiusOf(ActivityDto a) => a.RadiusMeters is > 0 ? a.RadiusMeters.Value : 25;
    private bool WithinRadius(ActivityDto a) => _distances.TryGetValue(a.Id, out var d) && d <= RadiusOf(a);
    private string LockText(ActivityDto a) => _distances.TryGetValue(a.Id, out var d)
        ? $"Walk closer · {(int)Math.Round(d)} m"
        : "Walk to the spot";

    private void SyncEditFields()
    {
        if (_event is null) return;
        _editName = _event.Name;
        _editDescription = _event.Description;
        _editImage = _event.ImageUrl;
        _editTeamSize = _event.TeamSize;
        _editScoring = _event.Scoring;
        _editSlapMode = _event.SlapMode;
        _editCode = _event.JoinCode;
    }

    private async Task SaveCodeAsync()
    {
        _busy = true;
        _adminError = null;
        try
        {
            _event = await Api.SetEventCodeAsync(Id, _editCode.Trim());
            SyncEditFields();
        }
        catch (ApiException ex)
