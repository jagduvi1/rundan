@page "/a/{Id:int}"
@implements IAsyncDisposable
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav

<PageTitle>@(_activity?.Title ?? "Activity") · Rundan</PageTitle>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else if (_activity is null)
{
    <div class="card">
        <h1>Not found</h1>
        <p class="muted">No activity with that code or id.</p>
        <a class="btn" href="events">Back to events</a>
    </div>
}
else
{
    <div class="card stack">
        @if (_activity.EventId is { } eventId)
        {
            <a class="btn ghost small" href="@($"e/{eventId}")" style="align-self:flex-start">‹ All activities</a>
        }
        <div class="row">
            <h1 class="grow">@_activity.Title</h1>
            <StatusBadge Status="_activity.Status" />
        </div>
        <div class="row muted" style="font-size:.85rem">
            <span>@Fmt.TypeLabel(_activity.Type)</span>
            <span>·</span>
            <span>code @_activity.JoinCode</span>
            @if (_reconnecting)
            {
                <span class="grow"></span>
                <span class="badge">Reconnecting…</span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_activity.ImageUrl) || !string.IsNullOrWhiteSpace(_activity.Description))
    {
        <div class="card stack">
            @if (!string.IsNullOrEmpty(_activity.ImageUrl))
            {
                <img src="@_activity.ImageUrl" alt="" class="media-img" />
            }
            @if (!string.IsNullOrWhiteSpace(_activity.Description))
            {
                <div class="rte-content">@((MarkupString)Fmt.RichHtml(_activity.Description))</div>
            }
        </div>
    }

    <div class="card stack">
        <h2>How it works</h2>
        <ul style="margin:.1rem 0 0;padding-left:1.15rem;line-height:1.55">
            @foreach (var line in Fmt.RulesSummary(_activity))
            {
                <li>@line</li>
            }
        </ul>
    </div>

    <div class="card">
        <h2>Scoreboard</h2>
        <Scoreboard Board="_board" MyParticipantId="_session?.ParticipantId" />
    </div>

    @if (State.IsHost && _activity.Type == ActivityType.MusicQuiz && _activity.Status != ActivityStatus.Draft)
    {
        <MusicHostPanel @key="_activity.Id" Activity="_activity" />
    }

    @if (_activity.Status == ActivityStatus.Draft)
    {
        <div class="card muted">This activity hasn't opened yet. The host is still setting it up.</div>
    }
    else if (_isViewer)
    {
        @* Spectator: the scoreboard above updates live; show the bracket / results too. *@
        <div class="card stack center">
            <span class="badge">Viewer</span>
            <p class="muted">You're watching this activity — scores update live above.</p>
            <button class="btn small secondary" @onclick="StopViewingAsync">Join to play</button>
        </div>
        @if (_activity.Type == ActivityType.Boule)
        {
            <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
        }
        else if (_activity.Status == ActivityStatus.Finished && _activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" />
        }
    }
    else if (_session is null)
    {
        @if (_activity.Status is ActivityStatus.Open or ActivityStatus.Live)
        {
            <JoinPanel Activity="_activity" OnJoined="OnJoinedAsync" />
            @if (_activity.EventId is not null)
            {
                <div class="card center muted">
                    <button class="btn ghost small" @onclick="WatchAsync">Just watch</button>
                </div>
            }
        }
        else if (_activity.Status == ActivityStatus.Finished && _activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" />
        }
        else
        {
            <div class="card muted">This activity has finished.</div>
        }
    }
    else if (_activity.Status == ActivityStatus.Open)
    {
        <div class="card stack">
            <h2>Waiting for the host to start…</h2>
            <p class="muted">You're in as <b>@_session.DisplayName</b>.</p>
        </div>
        <div class="card">
            <h2>@(_activity.IsTeamBased ? "Teams" : "Players") (@_participants.Count)</h2>
            <ul class="list">
                @foreach (var p in _participants)
                {
                    <li>
                        <span class="grow">@p.DisplayName</span>
                        @if (p.IsAdmin)
                        {
                            <span class="badge admin">host</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    else if (_activity.Status == ActivityStatus.Live)
    {
        @switch (_activity.Type)
        {
            case ActivityType.Quiz:
                <QuizPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.Tipspromenad:
                <TipspromenadPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.Boule:
                <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
                break;
            case ActivityType.WordGame:
                <WordGamePlay @key="_activity.Id" Activity="_activity" Session="_session" RefreshKey="_scoreVersion" />
                break;
            case ActivityType.MapPin:
                <MapPinPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.MusicQuiz:
                <MusicQuizPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            default:
                <BouleBoard @key="_activity.Id" Activity="_activity" Session="_session"
                            Participants="_participants" RefreshKey="_scoreVersion" />
                break;
        }
    }
    else // Finished
    {
        @if (_activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" Session="_session" />
        }
        else if (_activity.Type == ActivityType.Boule)
        {
            <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
        }
        else if (_activity.Type == ActivityType.WordGame)
        {
            <WordGamePlay @key="_activity.Id" Activity="_activity" Session="_session" RefreshKey="_scoreVersion" />
        }
        else
        {
            <div class="card success center">
                <h2>Final results</h2>
                <p class="muted">See the scoreboard above.</p>
            </div>
        }
    }

    @if (_activity.EventId is { } backId)
    {
        <a class="btn ghost block" href="@($"e/{backId}")">← Back to all activities</a>
    }

    @if (State.IsHost && !State.IsProxying)
    {
        <div class="card center muted">
            <a href="@($"manage/{_activity.Id}")">Manage this activity (host)</a>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ActivityDto? _activity;
    private ScoreboardDto? _board;
    private PlayerSession? _session;
    private List<ParticipantDto> _participants = new();

    private ScoreboardConnection? _conn;
    private int _loadedId = -1;
    private int _scoreVersion;
    private bool _loading = true;
    private bool _reconnecting;
    private bool _isViewer;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await TeardownConnectionAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await State.EnsureInitializedAsync(Api);
        _activity = await Api.GetActivityAsync(Id);

        if (_activity is not null)
        {
            if (_activity.EventId is { } evId)
            {
                _isViewer = await State.GetViewerAsync(evId);
            }

            _session = await State.GetSessionAsync(Id);
            _board = await Api.GetScoreboardAsync(Id);
            _participants = await Api.GetParticipantsAsync(Id);
            await StartConnectionAsync();
        }

        _loading = false;
    }

    private async Task StartConnectionAsync()
    {
        _conn = new ScoreboardConnection(Nav, State);
        _conn.ScoreboardUpdated += OnScoreboard;
        _conn.StatusChanged += OnStatusChanged;
        _conn.ParticipantJoined += OnParticipantJoined;
        _conn.ConnectionStateChanged += OnConnectionStateChanged;

        try
        {
            await _conn.StartAsync(Id);
        }
        catch
        {
            // Live updates unavailable (e.g. WebSockets blocked); the page still works via refresh.
        }
    }

    private void OnScoreboard(ScoreboardDto board)
    {
        _board = board;
        _scoreVersion++;
        InvokeAsync(StateHasChanged);
    }

    private void OnStatusChanged(ActivityStatusChangedDto status)
        => _ = InvokeAsync(async () =>
        {
            _activity = await Api.GetActivityAsync(Id);
            _participants = await Api.GetParticipantsAsync(Id);
            StateHasChanged();
        });

    private void OnParticipantJoined(ParticipantDto participant)
        => _ = InvokeAsync(async () =>
        {
            _participants = await Api.GetParticipantsAsync(Id);
            StateHasChanged();
        });

    private void OnConnectionStateChanged()
    {
        var wasReconnecting = _reconnecting;
        _reconnecting = _conn?.IsReconnecting ?? false;

        // Self-heal: when we come back from a drop, refetch in case a push was missed
        // during the outage (the rejoin alone can't recover messages sent while offline).
        if (wasReconnecting && _conn?.IsConnected == true)
        {
            _ = InvokeAsync(async () =>
            {
                _board = await Api.GetScoreboardAsync(Id);
                _activity = await Api.GetActivityAsync(Id) ?? _activity;
                _participants = await Api.GetParticipantsAsync(Id);
                StateHasChanged();
            });
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task WatchAsync()
    {
        if (_activity?.EventId is { } evId)
        {
            await State.SetViewerAsync(evId, true);
            _isViewer = true;
        }
    }

    private async Task StopViewingAsync()
    {
        if (_activity?.EventId is { } evId)
        {
            await State.SetViewerAsync(evId, false);
        }

        _isViewer = false;
    }

    private async Task OnJoinedAsync(JoinResultDto result)
    {
        _session = PlayerSession.FromJoin(result);
        await State.SaveSessionAsync(Id, _session);

        _activity = result.Activity;
        _participants = await Api.GetParticipantsAsync(Id);
        _board = await Api.GetScoreboardAsync(Id);
        StateHasChanged();
    }

    private async Task TeardownConnectionAsync()
    {
        if (_conn is not null)
        {
            _conn.ScoreboardUpdated -= OnScoreboard;
            _conn.StatusChanged -= OnStatusChanged;
            _conn.ParticipantJoined -= OnParticipantJoined;
            _conn.ConnectionStateChanged -= OnConnectionStateChanged;
            await _conn.DisposeAsync();
            _conn = null;
        }
    }

    public async ValueTask DisposeAsync() => await TeardownConnectionAsync();

}
