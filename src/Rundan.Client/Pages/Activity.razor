@page "/a/{Id:int}"
@implements IAsyncDisposable
@inject RundanApi Api
@inject AppState State
@inject NavigationManager Nav

<PageTitle>@(_activity?.Title ?? "Activity") · Rundan</PageTitle>

@if (_loading)
{
    <div class="card center muted"><div class="spinner" style="margin:1rem auto"></div></div>
}
else if (_activity is null)
{
    <div class="card">
        <h1>Not found</h1>
        <p class="muted">No activity with that code or id.</p>
        <a class="btn" href="events">Back to events</a>
    </div>
}
else
{
    <div class="card stack">
        @if (_activity.EventId is { } eventId)
        {
            <a class="btn ghost small" href="@($"e/{eventId}")" style="align-self:flex-start">‹ All activities</a>
        }
        <div class="row">
            <h1 class="grow">@_activity.Title</h1>
            <StatusBadge Status="_activity.Status" />
        </div>
        <div class="row muted" style="font-size:.85rem;align-items:center">
            <span>@Fmt.TypeLabel(_activity.Type)</span>
            <span>·</span>
            <span>code @_activity.JoinCode</span>
            <span class="grow"></span>
            @switch (Live)
            {
                case LiveState.Live:
                    <span class="badge" style="background:var(--green-100);color:var(--green-700)" title="Live updates are on">● Live</span>
                    break;
                case LiveState.Offline:
                    <span class="badge" style="background:var(--red-100,#fde8e8);color:var(--red-700,#b42318)" title="Live updates are off">● Offline</span>
                    <button class="btn ghost small" @onclick="ReconnectAsync" disabled="@_reconnectBusy">@(_reconnectBusy ? "…" : "Reconnect")</button>
                    break;
                default:
                    <span class="badge" title="Connecting to live updates">○ Connecting…</span>
                    break;
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_activity.ImageUrl) || !string.IsNullOrWhiteSpace(_activity.Description))
    {
        <div class="card stack">
            @if (!string.IsNullOrEmpty(_activity.ImageUrl))
            {
                <img src="@_activity.ImageUrl" alt="" class="media-img" />
            }
            @if (!string.IsNullOrWhiteSpace(_activity.Description))
            {
                <div class="rte-content">@((MarkupString)Fmt.RichHtml(_activity.Description))</div>
            }
        </div>
    }

    <div class="card stack">
        <h2>How it works</h2>
        <ul style="margin:.1rem 0 0;padding-left:1.15rem;line-height:1.55">
            @foreach (var line in Fmt.RulesSummary(_activity))
            {
                <li>@line</li>
            }
        </ul>
    </div>

    <div class="card">
        <h2>Scoreboard</h2>
        <Scoreboard Board="_board" MyParticipantId="_session?.ParticipantId" />
    </div>

    @* Slap ceremony — appears the moment this activity finishes (any order), winners act here. *@
    @if (_slap is not null)
    {
        <SlapCeremony Slap="_slap" ActingUserId="_eventUserId" CanManage="CanManage"
                      OnChanged="OnSlapChangedAsync" />
    }

    @if (_activity.Status == ActivityStatus.Draft)
    {
        <div class="card muted">This activity hasn't opened yet. The host is still setting it up.</div>
    }
    else if (_isViewer)
    {
        @* Spectator: the scoreboard above updates live; show the bracket / results too. *@
        <div class="card stack center">
            <span class="badge">Viewer</span>
            <p class="muted">You're watching this activity — scores update live above.</p>
            <button class="btn small secondary" @onclick="StopViewingAsync">Join to play</button>
        </div>
        @if (_activity.Type == ActivityType.Boule)
        {
            <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
        }
        else if (_activity.Status == ActivityStatus.Finished && _activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" />
        }
    }
    else if (_session is null)
    {
        @if (_activity.Status is ActivityStatus.Open or ActivityStatus.Live)
        {
            <JoinPanel Activity="_activity" OnJoined="OnJoinedAsync" />
            @if (_activity.EventId is not null)
            {
                <div class="card center muted">
                    <button class="btn ghost small" @onclick="WatchAsync">Just watch</button>
                </div>
            }
        }
        else if (_activity.Status == ActivityStatus.Finished && _activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" />
            <ResultsSummary @key='$"summary-{_activity.Id}"' Activity="_activity" />
        }
        else if (_activity.Status == ActivityStatus.Finished
            && _activity.Type is ActivityType.MusicQuiz or ActivityType.MapPin or ActivityType.Memory)
        {
            <ResultsSummary @key='$"summary-{_activity.Id}"' Activity="_activity" />
        }
        else
        {
            <div class="card muted">This activity has finished.</div>
        }
    }
    else if (_activity.Status == ActivityStatus.Open)
    {
        <div class="card stack">
            <h2>Waiting for the host to start…</h2>
            <p class="muted">You're in as <b>@_session.DisplayName</b>.</p>
        </div>
        <div class="card">
            <h2>@(_activity.IsTeamBased ? "Teams" : "Players") (@_participants.Count)</h2>
            <ul class="list">
                @foreach (var p in _participants)
                {
                    <li>
                        <span class="grow">@p.DisplayName</span>
                        @if (p.IsAdmin)
                        {
                            <span class="badge admin">host</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    else if (_activity.Status == ActivityStatus.Live)
    {
        @switch (_activity.Type)
        {
            case ActivityType.Quiz:
                <QuizPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.Tipspromenad:
                <TipspromenadPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.Boule:
                <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
                break;
            case ActivityType.WordGame:
                <WordGamePlay @key="_activity.Id" Activity="_activity" Session="_session" RefreshKey="_scoreVersion" />
                break;
            case ActivityType.MapPin:
                <MapPinPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            case ActivityType.MusicQuiz:
                <MusicQuizPlay @key="_activity.Id" Activity="_activity" Session="_session" Connection="_conn" />
                break;
            case ActivityType.Memory:
                <MemoryPlay @key="_activity.Id" Activity="_activity" Session="_session" />
                break;
            default:
                <BouleBoard @key="_activity.Id" Activity="_activity" Session="_session"
                            Participants="_participants" RefreshKey="_scoreVersion" Connection="_conn" />
                break;
        }
    }
    else // Finished
    {
        @if (_activity.UsesQuestions)
        {
            <ResultsView Activity="_activity" Session="_session" />
            <ResultsSummary @key='$"summary-{_activity.Id}"' Activity="_activity" />
        }
        else if (_activity.Type is ActivityType.MusicQuiz or ActivityType.MapPin or ActivityType.Memory)
        {
            <ResultsSummary @key='$"summary-{_activity.Id}"' Activity="_activity" />
        }
        else if (_activity.Type == ActivityType.Boule)
        {
            <BracketBoard @key="_activity.Id" Activity="_activity" RefreshKey="_scoreVersion" />
        }
        else if (_activity.Type == ActivityType.WordGame)
        {
            <WordGamePlay @key="_activity.Id" Activity="_activity" Session="_session" RefreshKey="_scoreVersion" />
        }
        else
        {
            <div class="card success center">
                <h2>Final results</h2>
                <p class="muted">See the scoreboard above.</p>
            </div>
        }
    }

    @if (CanManage && _activity.Type == ActivityType.MusicQuiz && _activity.Status != ActivityStatus.Draft)
    {
        @* Host's "tracks to play" panel — kept at the end so the scoreboard and play form sit on top.
           Distinct key: a host playing a live music quiz renders this AND <MusicQuizPlay> into the
           same parent, and @key must be unique across all keyed siblings (even of different types). *@
        <MusicHostPanel @key='$"musichost-{_activity.Id}"' Activity="_activity" />
    }

    @* Shared photo wall — once the activity is under way (not a draft). Distinct @key: the play
       component above is keyed on _activity.Id and renders into this same parent, and @key must be
       unique across all keyed siblings (even of different types). *@
    @if (_activity.Status != ActivityStatus.Draft)
    {
        <PhotoWall @key='$"photos-{_activity.Id}"' ActivityId="_activity.Id" Session="_session" CanManage="CanManage" />
    }

    @if (_activity.EventId is { } backId)
    {
        <a class="btn ghost block" href="@($"e/{backId}")">← Back to all activities</a>
    }

    @if (CanManage && !State.IsProxying)
    {
        <div class="card center muted">
            <a href="@($"manage/{_activity.Id}")">Manage this activity (host)</a>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ActivityDto? _activity;
    private ScoreboardDto? _board;
    private PlayerSession? _session;
    private List<ParticipantDto> _participants = new();

    private ScoreboardConnection? _conn;
    private int _loadedId = -1;
    private int _scoreVersion;
    private bool _loading = true;
    private bool _reconnecting;

    // Live-update self-heal: SignalR pushes the status change (the moment the play view / question
    // appears) and score updates, but a phone can miss a push — flaky signal, or WebSockets blocked in
    // the deployment. So we also poll every few seconds and catch up, so the question pops up for
    // everyone, on every activity type, without a manual refresh.
    private const int PollMs = 4000;
    private System.Threading.Timer? _poll;
    private bool _polling;
    private bool _disposed;
    private bool _isViewer;
    private ActivitySlapDto? _slap;
    private int? _eventUserId;

    // Per-event management (NOT the global host flag): an admin of THIS activity's event, the site host
    // (global admin code), or anyone when the event has no admins — the server decides via _activity.CanManage.
    private bool CanManage =>
        !State.PreviewAsPlayer
        && (State.HasAdminCode || (_activity?.CanManage ?? false));

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await TeardownConnectionAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        await State.EnsureInitializedAsync(Api);
        _activity = await Api.GetActivityAsync(Id);

        if (_activity is not null)
        {
            if (_activity.EventId is { } evId)
            {
                _isViewer = await State.GetViewerAsync(evId);
            }

            // Independent reads run together so the spinner doesn't wait on a serial chain of round-trips.
            var boardTask = Api.GetScoreboardAsync(Id);
            var participantsTask = Api.GetParticipantsAsync(Id);
            _session = await State.GetSessionAsync(Id);
            _board = await boardTask;
            _participants = await participantsTask;

            // For the slap ceremony: who this device is acting as in the event roster — the proxied
            // player when the host is "playing as" someone, otherwise this device's own claim — plus
            // the member token that lets them act (the ActiveMemberToken getter already prefers the
            // proxied player's token, so the server attributes the slap to them too).
            if (_activity.EventId is { } evId2)
            {
                // A "play as" overlay from a different event must not shadow this one's token.
                if (State.IsProxying && State.Proxy!.EventId != evId2)
                {
                    await State.ClearProxyAsync();
                }

                _eventUserId = State.IsProxying && State.Proxy!.EventId == evId2
                    ? State.Proxy.UserId
                    : await State.GetEventUserIdAsync(evId2);

                // Attach THIS event's member token (overwrite — a leftover token from another event we
                // visited must not stand in, or a genuine admin of this event is wrongly denied host UI).
                // When proxying this event the proxy's token already wins (the getter prefers it).
                var sentToken = State.ActiveMemberToken;
                if (!State.IsProxying)
                {
                    State.ActiveMemberToken = await State.GetEventMemberTokenAsync(evId2);
                }

                // The first GET went out with whatever token was set then; if it differs from this event's,
                // re-read so _activity.CanManage reflects our real event-admin status here.
                if (State.ActiveMemberToken != sentToken)
                {
                    _activity = await Api.GetActivityAsync(Id) ?? _activity;
                }
            }

            await LoadSlapAsync();

            // Live updates connect in the background — don't block the first render on the SignalR
            // handshake (or a slow long-polling fallback). Messages arrive once it's up; the data
            // above is already loaded, so the page is usable immediately.
            _ = StartConnectionAsync();
            StartPoll();
        }

        _loading = false;
    }

    private async Task LoadSlapAsync()
    {
        try
        {
            var slap = await Api.GetActivitySlapAsync(Id);
            _slap = slap is { State: not SlapState.None } ? slap : null;
        }
        catch (ApiException)
        {
            // leave the previous slap state on a transient error
        }
    }

    private async Task OnSlapChangedAsync()
    {
        await LoadSlapAsync();
        _board = await Api.GetScoreboardAsync(Id); // the slap shifted the standings
        StateHasChanged();
    }

    private async Task StartConnectionAsync()
    {
        _conn = new ScoreboardConnection(Nav, State);
        _conn.ScoreboardUpdated += OnScoreboard;
        _conn.StatusChanged += OnStatusChanged;
        _conn.ParticipantJoined += OnParticipantJoined;
        _conn.ConnectionStateChanged += OnConnectionStateChanged;

        try
        {
            await _conn.StartAsync(Id);
        }
        catch
        {
            // Live updates unavailable (e.g. WebSockets blocked); the page still works via refresh.
        }
    }

    private void OnScoreboard(ScoreboardDto board)
    {
        _board = board;
        _scoreVersion++;
        _ = InvokeAsync(async () =>
        {
            // A taken slap broadcasts a scoreboard push — refresh the ceremony's outcome once finished.
            if (_activity?.Status == ActivityStatus.Finished)
            {
                await LoadSlapAsync();
            }
            StateHasChanged();
        });
    }

    private void OnStatusChanged(ActivityStatusChangedDto status)
        => _ = InvokeAsync(async () =>
        {
            _activity = await Api.GetActivityAsync(Id);
            _participants = await Api.GetParticipantsAsync(Id);
            await LoadSlapAsync(); // finishing arms the slap ceremony
            StateHasChanged();
        });

    private void OnParticipantJoined(ParticipantDto participant)
        => _ = InvokeAsync(async () =>
        {
            _participants = await Api.GetParticipantsAsync(Id);
            StateHasChanged();
        });

    /// <summary>Health of the live (SignalR) connection, for the "Live" indicator.</summary>
    private LiveState Live => _conn?.GetLiveState() ?? LiveState.Connecting;
    private bool _reconnectBusy;

    // Manual reconnect: rebuild the live connection and pull fresh data right away (a phone that's been
    // offline catches up the moment they tap it, rather than waiting on the next poll).
    private async Task ReconnectAsync()
    {
        _reconnectBusy = true;
        StateHasChanged();
        try
        {
            if (_conn is not null)
            {
                await _conn.RestartAsync();
            }
            else
            {
                await StartConnectionAsync();
            }

            await PollAsync();
        }
        catch { /* best effort — the indicator will reflect whether it came back */ }
        finally
        {
            _reconnectBusy = false;
            StateHasChanged();
        }
    }

    private void StartPoll() =>
        _poll ??= new System.Threading.Timer(_ => _ = InvokeAsync(PollAsync), null, PollMs, PollMs);

    // Re-fetch the activity (and, on a status change, the rest) so a missed live push can't leave a
    // phone stuck on the lobby while everyone else is answering. Cheap GET; the host's "start" is the
    // status change we're racing to catch.
    private async Task PollAsync()
    {
        if (_disposed || _polling || _activity is null)
        {
            return;
        }

        _polling = true;
        try
        {
            var fresh = await Api.GetActivityAsync(Id);
            if (_disposed || fresh is null || _activity is null)
            {
                return;
            }

            var statusChanged = fresh.Status != _activity.Status;
            _activity = fresh;
            if (statusChanged)
            {
                // The big moment — the host opened / started / finished it. Pull the rest so the play
                // view (the question) appears and the slap ceremony arms, just like the live push would.
                _participants = await Api.GetParticipantsAsync(Id);
                await LoadSlapAsync();
                _scoreVersion++;
            }

            _board = await Api.GetScoreboardAsync(Id);
            StateHasChanged();
        }
        catch (ApiException) { /* transient — try again next tick */ }
        finally { _polling = false; }
    }

    private void OnConnectionStateChanged()
    {
        var wasReconnecting = _reconnecting;
        _reconnecting = _conn?.IsReconnecting ?? false;

        // Self-heal: when we come back from a drop, refetch in case a push was missed
        // during the outage (the rejoin alone can't recover messages sent while offline).
        if (wasReconnecting && _conn?.IsConnected == true)
        {
            _ = InvokeAsync(async () =>
            {
                _board = await Api.GetScoreboardAsync(Id);
                _activity = await Api.GetActivityAsync(Id) ?? _activity;
                _participants = await Api.GetParticipantsAsync(Id);
                StateHasChanged();
            });
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task WatchAsync()
    {
        if (_activity?.EventId is { } evId)
        {
            await State.SetViewerAsync(evId, true);
            _isViewer = true;
        }
    }

    private async Task StopViewingAsync()
    {
        if (_activity?.EventId is { } evId)
        {
            await State.SetViewerAsync(evId, false);
        }

        _isViewer = false;
    }

    private async Task OnJoinedAsync(JoinResultDto result)
    {
        _session = PlayerSession.FromJoin(result);
        await State.SaveSessionAsync(Id, _session);

        _activity = result.Activity;
        _participants = await Api.GetParticipantsAsync(Id);
        _board = await Api.GetScoreboardAsync(Id);
        StateHasChanged();
    }

    private async Task TeardownConnectionAsync()
    {
        _poll?.Dispose();
        _poll = null;
        if (_conn is not null)
        {
            _conn.ScoreboardUpdated -= OnScoreboard;
            _conn.StatusChanged -= OnStatusChanged;
            _conn.ParticipantJoined -= OnParticipantJoined;
            _conn.ConnectionStateChanged -= OnConnectionStateChanged;
            await _conn.DisposeAsync();
            _conn = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await TeardownConnectionAsync();
    }

}
