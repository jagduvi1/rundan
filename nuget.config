<?xml version="1.0" encoding="utf-8"?>
<!-- This repo only uses packages from nuget.org. Scope restore to it so a failing/auth-gated
     org feed in the machine-wide config can't block package restore (and the NU1900 noise). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
